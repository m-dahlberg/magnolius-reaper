desc:LUFS Limiter (LUFS-S leveler + true peak limiter)
// @description LUFS Limiter
// @author Magnolius
// @version 1.0
// @link GitHub https://github.com/m-dahlberg/Magnolius-REAPER
// @about
//   Two stages in series: a slow LUFS-S leveler (BS.1770 K-weighted, 3 s
//   window, 1-3 s lookahead) that rides the programme toward a loudness
//   target, followed by a true peak limiter that guarantees the sample
//   ceiling.
//
//   Splitting the job lets each stage work on the timescale it belongs on -
//   the leveler moves over seconds and is inaudible, and the limiter only has
//   the last dB or two of peak control left to do.
//
//   True peak detection uses an 8x oversampled polyphase FIR, so the ceiling
//   holds after conversion to lossy formats.
//
//   The Lookahead slider changes plugin latency and therefore PDC. Set it once
//   and leave it.
//
//   Licensed GPL-3.0-or-later.
// @changelog
//   Initial ReaPack release

// tags - dynamics limiter loudness
// Stage 1: slow LUFS-S (BS.1770, 3 s window) leveler with 1-3 s lookahead.
//          Smoothly rides gain down so short-term loudness stays at/below the ceiling.
// Stage 2: true peak limiter (Turquoise Limiter S2 topology: 1 ms lookahead,
//          instant-attack envelope, threshold/env transfer, one-pole release,
//          optional 8x oversampled inter-sample peak detection).
// Then an output trim.
//
// NOTE: the Lookahead slider changes plugin latency (PDC) - set and forget.

slider1:lufs_ceil=-14<-36,0,0.1>LUFS-S Ceiling (LUFS)
slider2:speed_ms=500<20,5000,1>Leveler Speed (ms)
slider3:amount_pct=100<0,100,1>Leveler Amount (%)
slider4:lookahead_s=1.5<1,3,0.05>Lookahead (s, changes latency)
slider5:limit_db=-1<-32,0,0.1>Limit Ceiling (dB)
slider6:release_ms=100<20,800,1>Limiter Release (ms)
slider7:tpl_on=1<0,1,1{Off,On}>True Peak Detection (TPL)
slider8:trim_db=0<-24,24,0.1>Output Trim (dB)

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R

@init
ext_noinit = 1;
ext_gr_meter = 0;

DB2LN = 0.11512925464970228;  // ln(10)/20
HISTN = 800;                  // gain-reduction history bins (covers HIST_SECS)
HIST_SECS = 8;
GRDB = 24;                    // GR graph/meter range in dB

function g2db(x) ( 20*log10(max(abs(x), 0.0000001)) );

// ------------------------------------------------------------------ memory
tp_fir = 0;                              // 64-tap 8-phase polyphase FIR
pwmax  = (3*srate)|0;                    // 3 s worst case
pw_buf = 1024;                           // K-weighted power, sliding window
dly_l  = pw_buf + pwmax + 64;            // stage-1 lookahead delay line
dly_r  = dly_l  + pwmax + 64;
s2_l   = dly_r  + pwmax + 64;            // stage-2 1 ms lookahead
s2_r   = s2_l + 512;
hist1  = s2_r + 512;                     // stage-1 gain history (min-hold)
hist2  = hist1 + HISTN;                  // stage-2 gain history (min-hold)

// ------------------------------------------- 8x oversampler (TPL detection)
// Polyphase windowed-sinc interpolator, 8 phases x 8 taps, unity-normalized.
i = 0;
loop(64,
  t = (i - 31.5)/8;
  w = 0.42 - 0.5*cos(2*$pi*i/63) + 0.08*cos(4*$pi*i/63); // Blackman
  tp_fir[i] = w * sin($pi*t)/($pi*t);
  i += 1;
);
p = 0;
loop(8,
  s = 0; k = 0; loop(8, s += tp_fir[8*k+p]; k += 1; );
  k = 0; loop(8, tp_fir[8*k+p] /= s; k += 1; );
  p += 1;
);

function tp_up8(x) instance(x0 x1 x2 x3 x4 x5 x6 x7 pk) local(v ph) (
  x7=x6; x6=x5; x5=x4; x4=x3; x3=x2; x2=x1; x1=x0; x0=x;
  pk = 0; ph = 0;
  loop(8,
    v = x0*tp_fir[ph]    + x1*tp_fir[ph+8]  + x2*tp_fir[ph+16] + x3*tp_fir[ph+24]
      + x4*tp_fir[ph+32] + x5*tp_fir[ph+40] + x6*tp_fir[ph+48] + x7*tp_fir[ph+56];
    pk = max(pk, abs(v));
    ph += 1;
  );
  pk;
);

// -------------------------------------------------- K-weighting (BS.1770)
// Stage 1: high shelf (+4 dB), Stage 2: RLB high-pass. Coefficients computed
// for the running srate (De Man parameterization, matches spec @48k).
kw_db = 3.999843853973347;
kw_f0 = 1681.974450955533;
kw_q  = 0.7071752369554196;
kk = tan($pi*kw_f0/srate);
kw_vh = 10^(kw_db/20);
kw_vb = kw_vh^0.4996667741545416;
kw_a0 = 1 + kk/kw_q + kk*kk;
sh_b0 = (kw_vh + kw_vb*kk/kw_q + kk*kk)/kw_a0;
sh_b1 = 2*(kk*kk - kw_vh)/kw_a0;
sh_b2 = (kw_vh - kw_vb*kk/kw_q + kk*kk)/kw_a0;
sh_a1 = 2*(kk*kk - 1)/kw_a0;
sh_a2 = (1 - kk/kw_q + kk*kk)/kw_a0;

kw_f0 = 38.13547087602444;
kw_q  = 0.5003270373238773;
kk = tan($pi*kw_f0/srate);
kw_a0 = 1 + kk/kw_q + kk*kk;
hp_a1 = 2*(kk*kk - 1)/kw_a0;
hp_a2 = (1 - kk/kw_q + kk*kk)/kw_a0;
// hp b = [1, -2, 1] (per spec)

function kshelf(x) instance(x1 x2 y1 y2) local(y) (
  y = sh_b0*x + sh_b1*x1 + sh_b2*x2 - sh_a1*y1 - sh_a2*y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function khp(x) instance(x1 x2 y1 y2) local(y) (
  y = x - 2*x1 + x2 - hp_a1*y1 - hp_a2*y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);

// ----------------------------------------------------------------- state
pw_len = pwmax;
memset(pw_buf, 0, pwmax);
pw_sum = pw_acc = 0; pw_pos = 0;

s2_len = max(1, (srate/1000)|0);
memset(s2_l, 0, 512); memset(s2_r, 0, 512);
s2_pos = 0;

la_len = -1;                // forces delay-line (re)build in @slider

env_decay = exp(-1/(0.019*srate));   // Tukan hard-mode envelope decay (~19 ms)
mtr_fall  = 20/srate;                // meter fallback, dB/s

g1 = 1; gain2 = 1; env2 = 0;
lufs_s = -120;

memset(hist1, 1, HISTN);
memset(hist2, 1, HISTN);
h_pos = 0; h_cnt = 0; h_g1 = 1; h_g2 = 1;
h_spb = max(1, ((HIST_SECS*srate)/HISTN)|0);

mtr_gr = 0; hold_gr = 0;
mtr_outl = mtr_outr = -120;
hold_outl = hold_outr = -120;
last_cap = 0;

// --------------------------------------------------------- gfx: GR curves
function draw_gr_curve(buf) local(i bin g y) (
  i = 0;
  while (i < gww) (
    bin = h_pos + ((i*HISTN)/gww)|0;
    bin >= HISTN ? bin -= HISTN;
    g = buf[bin];
    y = gy0 + min(GRDB, -(g2db(g))) * ghh / GRDB;
    y = min(max(y, gy0), gy0 + ghh);
    i == 0 ? ( gfx_x = gx0; gfx_y = y; ) : gfx_lineto(gx0 + i, y, 1);
    i += 1;
  );
);

@slider
sm_coef = exp(-1/(max(speed_ms,1)*0.001*srate));
amount  = amount_pct*0.01;

new_la = max(1, min(pwmax, (lookahead_s*srate)|0));
new_la != la_len ? (
  la_len = new_la;
  memset(dly_l, 0, pwmax);
  memset(dly_r, 0, pwmax);
  dly_pos = 0;
);

thresh2 = 10^(limit_db/20);
rel2 = exp(-1/(max(release_ms,20)*0.0005*srate)); // Tukan: release/2 ms
trim = 10^(trim_db/20);

pdc_bot_ch = 0; pdc_top_ch = 2;
pdc_delay = la_len + s2_len;
ext_tail_size = pdc_delay;

@sample
in0 = spl0; in1 = spl1;

// ---------------- stage 1: LUFS-S measurement (on undelayed input) --------
kl = kwl_hp.khp(kwl_sh.kshelf(in0));
kr = kwr_hp.khp(kwr_sh.kshelf(in1));
pw = kl*kl + kr*kr;

pw_sum += pw - pw_buf[pw_pos];    // sliding sum, add new / drop old
pw_acc += pw;                     // fresh accumulator kills float drift
pw_buf[pw_pos] = pw;
pw_pos += 1;
pw_pos >= pw_len ? (
  pw_pos = 0;
  pw_sum = pw_acc;                // exact sum of the last full window
  pw_acc = 0;
);

lufs_s = -0.691 + 10*log10(max(pw_sum/pw_len, 0.000000000001));

// target gain: pull LUFS-S down to the ceiling, scaled by Amount, smoothed
gr1_db = min(0, lufs_ceil - lufs_s) * amount;
tgt = exp(gr1_db * DB2LN);
g1 = tgt + sm_coef*(g1 - tgt);

// lookahead delay: gain curve leads the audio by la_len samples
dl0 = dly_l[dly_pos]; dl1 = dly_r[dly_pos];
dly_l[dly_pos] = in0; dly_r[dly_pos] = in1;
dly_pos += 1;
dly_pos >= la_len ? dly_pos = 0;

s1l = dl0 * g1;
s1r = dl1 * g1;

// ---------------- stage 2: true peak limiter (Tukan topology) -------------
tpl_on ? (
  det = max(tpl_l.tp_up8(s1l), tpl_r.tp_up8(s1r));
) : (
  det = max(abs(s1l), abs(s1r));
);

env2 = det >= env2 ? det : det + env_decay*(env2 - det);
tg = env2 > thresh2 ? thresh2/env2 : 1;
gain2 = tg < gain2 ? tg : tg + rel2*(gain2 - tg);

o0 = s2_l[s2_pos]; o1 = s2_r[s2_pos];
s2_l[s2_pos] = s1l; s2_r[s2_pos] = s1r;
s2_pos += 1;
s2_pos >= s2_len ? s2_pos = 0;

spl0 = o0 * gain2 * trim;
spl1 = o1 * gain2 * trim;

// ---------------- metering + history ---------------------------------------
grn = g2db(g1*gain2);
grn < mtr_gr ? ( mtr_gr = grn; ) : ( mtr_gr = min(0, mtr_gr + mtr_fall); );
hold_gr = min(hold_gr, grn);
ext_gr_meter = grn;

ol = g2db(spl0);
ol > mtr_outl ? ( mtr_outl = ol; ) : ( mtr_outl = max(-120, mtr_outl - mtr_fall); );
hold_outl = max(hold_outl, ol);
or_ = g2db(spl1);
or_ > mtr_outr ? ( mtr_outr = or_; ) : ( mtr_outr = max(-120, mtr_outr - mtr_fall); );
hold_outr = max(hold_outr, or_);

h_g1 = min(h_g1, g1);
h_g2 = min(h_g2, gain2);
h_cnt += 1;
h_cnt >= h_spb ? (
  hist1[h_pos] = h_g1;
  hist2[h_pos] = h_g2;
  h_pos += 1;
  h_pos >= HISTN ? h_pos = 0;
  h_g1 = h_g2 = 1;
  h_cnt = 0;
);

@gfx 700 360
gfx_setfont(1, "Arial", 13);

// layout
mw  = 170;                       // meter panel width
gx0 = 44; gy0 = 28;
gww = (gfx_w - mw - gx0 - 10)|0;
ghh = gfx_h - gy0 - 34;

gfx_r = 0.07; gfx_g = 0.07; gfx_b = 0.09; gfx_a = 1;
gfx_rect(0, 0, gfx_w, gfx_h);

gww > 10 && ghh > 10 ? (

  // ------- status line -------
  gfx_r = gfx_g = gfx_b = 0.8;
  gfx_x = gx0; gfx_y = 7;
  gfx_printf("LUFS-S in: %6.1f    Stage1 GR: %5.1f dB    Stage2 GR: %5.1f dB    Latency: %d ms",
             lufs_s, g2db(g1), g2db(gain2), ((pdc_delay*1000/srate)|0));

  // ------- GR graph -------
  gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.03;
  gfx_rect(gx0, gy0, gww, ghh);

  dbl = 0;
  loop(5,
    yy = gy0 + dbl*ghh/GRDB;
    gfx_r = gfx_g = gfx_b = 0.25; gfx_a = 1;
    gfx_line(gx0, yy, gx0 + gww, yy);
    gfx_x = 6; gfx_y = yy - 6;
    gfx_r = gfx_g = gfx_b = 0.55;
    gfx_printf("%3d", -dbl);
    dbl += 6;
  );

  gfx_r = 1; gfx_g = 0.55; gfx_b = 0.15; gfx_a = 1;   // stage 2: orange
  draw_gr_curve(hist2);
  gfx_r = 0; gfx_g = 0.85; gfx_b = 1; gfx_a = 1;      // stage 1: cyan
  draw_gr_curve(hist1);

  gfx_r = gfx_g = gfx_b = 0.5;
  gfx_x = gx0; gfx_y = gy0 + ghh + 6;
  gfx_printf("gain reduction, last %d s   ", HIST_SECS);
  gfx_r = 0; gfx_g = 0.85; gfx_b = 1; gfx_drawstr("leveler ");
  gfx_r = 1; gfx_g = 0.55; gfx_b = 0.15; gfx_drawstr("limiter");

  // ------- meters -------
  mx = gfx_w - mw + 6;
  bw = 30;
  bx_gr = mx; bx_l = mx + 56; bx_r = mx + 96;

  // frames
  gfx_r = gfx_g = gfx_b = 0.25;
  gfx_rect(bx_gr, gy0, bw, ghh, 0);
  gfx_rect(bx_l,  gy0, bw, ghh, 0);
  gfx_rect(bx_r,  gy0, bw, ghh, 0);

  // GR bar: grows downward from 0 dB, range GRDB
  grh = min(GRDB, -(mtr_gr)) * ghh / GRDB;
  gfx_r = 1; gfx_g = 0.25; gfx_b = 0.25; gfx_a = 0.9;
  gfx_rect(bx_gr + 1, gy0 + 1, bw - 2, max(0, grh - 1));

  // output bars: bottom-up, 60 dB range
  olh = max(0, min(1, (mtr_outl + 60)/60)) * ghh;
  orh = max(0, min(1, (mtr_outr + 60)/60)) * ghh;
  gfx_r = 0; gfx_g = 0.85; gfx_b = 1; gfx_a = 0.9;
  gfx_rect(bx_l + 1, gy0 + ghh - olh, bw - 2, olh);
  gfx_rect(bx_r + 1, gy0 + ghh - orh, bw - 2, orh);

  // labels + peak-hold readouts
  gfx_a = 1;
  gfx_r = gfx_g = gfx_b = 0.7;
  gfx_x = bx_gr + 7; gfx_y = gy0 + ghh + 6; gfx_drawstr("GR");
  gfx_x = bx_l + 12; gfx_y = gy0 + ghh + 6; gfx_drawstr("L");
  gfx_x = bx_r + 11; gfx_y = gy0 + ghh + 6; gfx_drawstr("R");

  gfx_x = bx_gr - 4; gfx_y = gy0 + ghh + 20;
  gfx_printf("%5.1f", hold_gr);
  hold_outl > -0.05 ? ( gfx_r = 1; gfx_g = 0.25; gfx_b = 0.25; ) : ( gfx_r = gfx_g = gfx_b = 0.7; );
  gfx_x = bx_l - 6; gfx_y = gy0 + ghh + 20;
  hold_outl > -119 ? gfx_printf("%5.1f", hold_outl);
  hold_outr > -0.05 ? ( gfx_r = 1; gfx_g = 0.25; gfx_b = 0.25; ) : ( gfx_r = gfx_g = gfx_b = 0.7; );
  gfx_x = bx_r - 6; gfx_y = gy0 + ghh + 20;
  hold_outr > -119 ? gfx_printf("%5.1f", hold_outr);

  gfx_r = gfx_g = gfx_b = 0.45;
  gfx_x = mx; gfx_y = 7;
  gfx_drawstr("click meters to reset");

  // click on meter panel resets peak holds
  mclick = (mouse_cap&1) && !(last_cap&1);
  mclick && mouse_x >= gfx_w - mw ? (
    hold_gr = 0;
    hold_outl = hold_outr = -120;
    mtr_outl = mtr_outr = -120;
    mtr_gr = 0;
  );
  last_cap = mouse_cap;
);
