// ---------------------------------------------------------------- recalc

// Everything derived from the sliders, in one place.  Called from @slider,
// from @init and from @gfx.
//
// *** DO NOT ADD local() OR PARAMETERS OR LOOPS TO THIS FUNCTION. ***
// See THREADING.
function recalc()
(
  gin_tg = input_db;
  out_tg = output_db;
  sl_tg = slew*0.01;
  asy_tg = asym*0.01;
  sym_tg = sym*0.01;
  kn_tg = min(max(floor(knee + 0.5), 0), 2);
  aw_tg = auto_gain > 0.5 ? 1 : 0;
  mix_tg = mix*0.01;
  os_tg = min(max(floor(os_i + 0.5), 0), 2);
  lat_tg = os_tg == 0 ? LAT1 : os_tg == 1 ? LAT2 : LAT4;
  sm_a = 1 - exp(-1/(SM_T*srate));
  kn_step = 1/(KNEE_XF_T*srate);
  mtr_fall = exp(-1/(MTR_FALL_T*srate));
  mtr_a = 1 - exp(-1/(MTR_RMS_T*srate));
);

// ---------------------------------------------------------------- audio side

// Parameters that follow the oversampling factor.  AUDIO THREAD ONLY.
function rate_params()
(
  os_fac = os_cur == 0 ? 1 : os_cur == 1 ? 2 : 4;
  adaa_on = os_cur > 0;
  r_dc = exp(-2*$pi*DC_HZ/(srate*os_fac));
  slew_rr = srate*os_fac/SLEW_REF;
  comp_t = os_cur == 1 ? COMP2 : COMP4;
  comp_l = os_cur == 1 ? 5 : 3;
);

// The antiderivative of f_k (even), Hermite on the table with exact slopes,
// a straight line past the peak.  AUDIO THREAD ONLY.
function kn_anti(kb, u) local(a, us, t, i, t2, t3, h, ffb, fb)
(
  a = abs(u);
  us = KN_US[kb];
  a >= us ? (
    KN_FSS[kb] + KN_FS[kb]*(a - us);
  ) : (
    t = a*KN_IH[kb];
    i = min(floor(t), FT_N - 1);
    t -= i;
    t2 = t*t; t3 = t2*t;
    h = KN_H[kb];
    ffb = KN_TAB + kb*KN_STRIDE + i;
    fb = ffb + KN_FOFF;
    (2*t3 - 3*t2 + 1)*ffb[0] + (t3 - 2*t2 + t)*h*fb[0]
      + (3*t2 - 2*t3)*ffb[1] + (t3 - t2)*h*fb[1];
  );
);

// f_k, flat past its peak.  AUDIO THREAD ONLY.
function kn_curve(kb, u) local(a, r, p)
(
  a = abs(u);
  a >= KN_US[kb] ? (
    r = KN_FS[kb];
    u >= 0 ? r : -r;
  ) : a < TINY_U ? (
    u;
  ) : (
    p = a^KN_K[kb];
    r = sin(a*p)/p;
    u >= 0 ? r : -r;
  );
);

// The asymmetric curve without its dry crossfade, and its antiderivative.
// Parameters set per base sample in @sample.  AUDIO THREAD ONLY.
function asy_curve(x)
(
  x > asy_xu ? asy_chi : x < asy_xl ? asy_clo :
    (sin(asy_g*x + asy_b) - asy_sb)*asy_inv;
);
function asy_anti(x)
(
  x > asy_xu ? asy_fhi + asy_chi*(x - asy_xu) :
  x < asy_xl ? asy_flo + asy_clo*(x - asy_xl) :
    (-cos(asy_g*x + asy_b)*asy_ginv - x*asy_sb)*asy_inv;
);

// Polyphase halfband interpolator: writes x into a ring of 64 at idx and
// leaves the two output phases in hb_e (on the input grid, K late) and hb_o
// (half a sample after it).  AUDIO THREAD ONLY.
function hb_up(ring, idx, x, c, kk) local(i, o)
(
  ring[idx] = x;
  hb_e = ring[(idx + 64 - kk) & 63];
  o = 0; i = 1;
  loop(kk,
    o += c[i]*(ring[(idx + 128 - (kk - 1) - i) & 63] + ring[(idx + 64 - kk + i) & 63]);
    i += 1;
  );
  hb_o = 2*o;
);

// Polyphase halfband decimator over the even/odd rings, sample idx just
// written.  AUDIO THREAD ONLY.
function hb_dec(re, ro, idx, c, kk) local(i, y)
(
  y = 0.5*re[(idx + 64 - kk) & 63];
  i = 1;
  loop(kk,
    y += c[i]*(ro[(idx + 128 - kk - i) & 63] + ro[(idx + 64 - kk - 1 + i) & 63]);
    i += 1;
  );
  y;
);

// Auto-gain table, multilinear, one knee.  AUDIO THREAD ONLY.
function ag_interp(kb) local(cg, cs, ca, cy, ig, isl, ia, iy, fg, fs, fa, fy, jg, js, ja, wg, ws, wa, base, acc)
(
  cg = min(max((gin_sm - AG_GMIN)/AG_GSTEP, 0), AG_NG - 1);
  cs = min(max(sl_sm*(AG_NS - 1), 0), AG_NS - 1);
  ca = min(max(asy_sm*(AG_NA - 1), 0), AG_NA - 1);
  cy = min(max(sym_sm*(AG_NY - 1), 0), AG_NY - 1);
  ig = min(floor(cg), AG_NG - 2); fg = cg - ig;
  isl = min(floor(cs), AG_NS - 2); fs = cs - isl;
  ia = min(floor(ca), AG_NA - 2); fa = ca - ia;
  iy = min(floor(cy), AG_NY - 2); fy = cy - iy;
  acc = 0; jg = 0;
  loop(2,
    wg = jg ? fg : 1 - fg;
    js = 0;
    loop(2,
      ws = wg*(js ? fs : 1 - fs);
      ja = 0;
      loop(2,
        wa = ws*(ja ? fa : 1 - fa);
        base = AG_TAB + (((kb*AG_NG + ig + jg)*AG_NS + isl + js)*AG_NA + ia + ja)*AG_NY + iy;
        acc += wa*((1 - fy)*base[0] + fy*base[1]);
        ja += 1;
      );
      js += 1;
    );
    jg += 1;
  );
  acc;
);
function ag_lookup() local(acc)
(
  acc = 0;
  kw0 > 0 ? acc += kw0*ag_interp(0);
  kw1 > 0 ? acc += kw1*ag_interp(1);
  kw2 > 0 ? acc += kw2*ag_interp(2);
  acc;
);

// One OS-rate sample through slew -> asym -> sym -> residual DC -> mix ->
// droop EQ.  Called as chL.os_sample / chR.os_sample.  AUDIO THREAD ONLY.
function os_sample(v) instance(sy, axp, yxp, dp1, dp2, rp, hpv, ic, base)
  local(d, st, s, xp, dx, cv, a, u1, u0, du, f, um, y, d1, dd, r, h, o, cr, acc, k)
(
  // slew
  s_r > 0 ? (
    d = v - sy;
    st = sin(min(abs(d)*s_r, HALF_PI))*s_rinv;
    d >= 0 ? (sy += st;) : (sy -= st;);
  ) : (
    sy = v;
  );
  s = sy;
  // asymmetric
  adaa_on ? (
    xp = axp; axp = s;
    asy_sm > 0 ? (
      dx = s - xp;
      abs(dx*asy_g) > ADAA_EPS ? (
        cv = (asy_anti(s) - asy_anti(xp))/dx;
      ) : (
        cv = asy_curve((s + xp)*0.5);
      );
      a = (1 - asy_sm)*((s + xp)*0.5) + asy_sm*cv;
    ) : (
      a = (s + xp)*0.5;
    );
  ) : (
    a = asy_sm > 0 ? (1 - asy_sm)*s + asy_sm*asy_curve(s) : s;
  );
  // symmetric
  adaa_on ? (
    xp = yxp; yxp = a;
    sym_sm > 0 ? (
      u1 = sym_g*a; u0 = sym_g*xp;
      du = u1 - u0;
      f = 0;
      abs(du) > ADAA_EPS ? (
        kw0 > 0 ? f += kw0*(kn_anti(0, u1) - kn_anti(0, u0));
        kw1 > 0 ? f += kw1*(kn_anti(1, u1) - kn_anti(1, u0));
        kw2 > 0 ? f += kw2*(kn_anti(2, u1) - kn_anti(2, u0));
        f = f/du*sym_ginv;
      ) : (
        um = (u1 + u0)*0.5;
        kw0 > 0 ? f += kw0*kn_curve(0, um);
        kw1 > 0 ? f += kw1*kn_curve(1, um);
        kw2 > 0 ? f += kw2*kn_curve(2, um);
        f *= sym_ginv;
      );
      y = (1 - sym_sm)*((a + xp)*0.5) + sym_sm*f;
    ) : (
      y = (a + xp)*0.5;
    );
  ) : (
    sym_sm > 0 ? (
      u1 = sym_g*a;
      f = 0;
      kw0 > 0 ? f += kw0*kn_curve(0, u1);
      kw1 > 0 ? f += kw1*kn_curve(1, u1);
      kw2 > 0 ? f += kw2*kn_curve(2, u1);
      y = (1 - sym_sm)*a + sym_sm*f*sym_ginv;
    ) : (
      y = a;
    );
  );
  // the dry signal, aligned to the curves' linear part exactly
  adaa_on ? (
    d1 = (v + dp1)*0.5;
    dd = (d1 + dp2)*0.5;
    dp1 = v; dp2 = d1;
  ) : (
    dd = v;
  );
  // residual DC blocker, then Mix and auto gain
  r = y - dd;
  h = r - rp + r_dc*hpv;
  rp = r; hpv = h;
  o = dd*dry_k + (dd + h)*wet_k;
  // ADAA droop EQ: symmetric FIR on a ring of 16
  adaa_on ? (
    cr = base + EQR;
    cr[ic] = o;
    acc = comp_t[0]*cr[(ic + 16 - comp_l) & 15];
    k = 1;
    loop(comp_l,
      acc += comp_t[k]*(cr[(ic + 16 - comp_l + k) & 15] + cr[(ic + 32 - comp_l - k) & 15]);
      k += 1;
    );
    ic = (ic + 1) & 15;
    o = acc;
  );
  o;
);

// 4x only: one 2x-rate sample w through the second interpolator, both 4x
// samples through the stages, back down to 2x into ring[idx1].
function os4_pair(w, ring, idx1) instance(i2, base) local(we, wo, r2e, r2o)
(
  hb_up(base + UP2, i2, w, C2, K2);
  we = hb_e; wo = hb_o;
  r2e = base + D2E; r2o = base + D2O;
  r2e[i2] = this.os_sample(we);
  r2o[i2] = this.os_sample(wo);
  ring[idx1] = hb_dec(r2e, r2o, i2, C2, K2);
  i2 = (i2 + 1) & 63;
);

// One base-rate sample of one channel.  AUDIO THREAD ONLY.
function ch_proc(x) instance(i1, base) local(v, e1, o1, de, dod, y)
(
  v = x*gin_lin;
  os_cur == 0 ? (
    y = this.os_sample(v);
  ) : (
    hb_up(base + UP1, i1, v, C1, K1);
    e1 = hb_e; o1 = hb_o;
    de = base + D1E; dod = base + D1O;
    os_cur == 1 ? (
      de[i1] = this.os_sample(e1);
      dod[i1] = this.os_sample(o1);
    ) : (
      this.os4_pair(e1, de, i1);
      this.os4_pair(o1, dod, i1);
    );
    y = hb_dec(de, dod, i1, C1, K1);
    i1 = (i1 + 1) & 63;
  );
  y;
);

// Clear one channel's oversampler, curve and filter state.  AUDIO THREAD ONLY.
function ch_reset() instance(sy, axp, yxp, dp1, dp2, rp, hpv, ic, i1, i2, base)
(
  memset(base, 0, 400);
  sy = axp = yxp = dp1 = dp2 = rp = hpv = 0;
  ic = i1 = i2 = 0;
);
function reset_channels()
(
  chL.base = CH_L; chR.base = CH_R;
  chL.ch_reset(); chR.ch_reset();
);

// REAPER runs @init with the DEFAULT slider values and only then applies the
// project's, so without this the smoothed controls would glide from the
// defaults over the first ~100 ms of playback.  Called from @slider until the
// first sample has run.  AUDIO THREAD ONLY.
function snap_states()
(
  gin_sm = gin_tg; out_sm = out_tg; sl_sm = sl_tg;
  asy_sm = asy_tg; sym_sm = sym_tg; aw_sm = aw_tg; mix_sm = mix_tg;
  kw0 = kn_tg == 0; kw1 = kn_tg == 1; kw2 = kn_tg == 2;
  os_cur != os_tg ? ( os_cur = os_tg; reset_channels(); );
  rate_params();
  ag_db = ag_lookup(); ag_step = 0; ag_cnt = 0;
  pdc_delay = lat_tg; pdc_bot_ch = 0; pdc_top_ch = 2;
);

function snap_to(x, t) ( abs(t - x) < SNAP ? t : x; );

recalc();
os_cur = os_tg;
reset_channels();
snap_states();
first_run = 1;
m_in_pk = m_out_pk = ms_in = ms_out = 0;

@slider
recalc();
first_run ? snap_states();

@serialize
// GUI-only state: saved with the project, never in automation.
// APPEND new values, never insert.
file_var(0, gui_scale_idx);

@block
pdc_delay = lat_tg; pdc_bot_ch = 0; pdc_top_ch = 2;

@sample
first_run = 0;

// smoothed controls
gin_sm += sm_a*(gin_tg - gin_sm); gin_sm = snap_to(gin_sm, gin_tg);
out_sm += sm_a*(out_tg - out_sm); out_sm = snap_to(out_sm, out_tg);
sl_sm  += sm_a*(sl_tg - sl_sm);   sl_sm  = snap_to(sl_sm, sl_tg);
asy_sm += sm_a*(asy_tg - asy_sm); asy_sm = snap_to(asy_sm, asy_tg);
sym_sm += sm_a*(sym_tg - sym_sm); sym_sm = snap_to(sym_sm, sym_tg);
aw_sm  += sm_a*(aw_tg - aw_sm);   aw_sm  = snap_to(aw_sm, aw_tg);
mix_sm += sm_a*(mix_tg - mix_sm); mix_sm = snap_to(mix_sm, mix_tg);

// Knee: the target's weight ramps up, the others share what is left
kn_old = kn_tg == 0 ? kw0 : kn_tg == 1 ? kw1 : kw2;
kn_old < 1 ? (
  kn_new = min(1, kn_old + kn_step);
  kn_sc = (1 - kn_new)/(1 - kn_old);
  kw0 = kn_tg == 0 ? kn_new : kw0*kn_sc;
  kw1 = kn_tg == 1 ? kn_new : kw1*kn_sc;
  kw2 = kn_tg == 2 ? kn_new : kw2*kn_sc;
);

// oversampling change: a setup control, so a plain reset
os_tg != os_cur ? (
  os_cur = os_tg;
  reset_channels();
  rate_params();
);

// per-sample parameters shared by both channels
gin_lin = exp(gin_sm*DB2LOG);
gin_inv = exp(-gin_sm*DB2LOG);
gout_lin = exp(out_sm*DB2LOG);
s_r = SLEW_MAX*sl_sm*sl_sm*slew_rr;
s_rinv = s_r > 0 ? 1/s_r : 0;
asy_g = 1 + ASYM_DRIVE*asy_sm;
asy_ginv = 1/asy_g;
asy_b = asy_sm*B_MAX;
asy_sb = sin(asy_b);
asy_inv = 1/(asy_g*cos(asy_b));
asy_xu = (HALF_PI - asy_b)*asy_ginv;
asy_xl = (-HALF_PI - asy_b)*asy_ginv;
asy_chi = (1 - asy_sb)*asy_inv;
asy_clo = (-1 - asy_sb)*asy_inv;
asy_fhi = -asy_xu*asy_sb*asy_inv;
asy_flo = -asy_xl*asy_sb*asy_inv;
sym_g = 1 + SYM_DRIVE*sym_sm;
sym_ginv = 1/sym_g;

// auto gain: the table every AG_BLK samples, a linear ramp in between
ag_cnt <= 0 ? (
  ag_step = (ag_lookup() - ag_db)/AG_BLK;
  ag_cnt = AG_BLK;
);
ag_cnt -= 1;
ag_db += ag_step;
wet_g = 1 - aw_sm + aw_sm*gin_inv*exp(ag_db*DB2LOG);
dry_k = (1 - mix_sm)*gin_inv;
wet_k = mix_sm*wet_g;

in_l = spl0; in_r = spl1;
o_l = chL.ch_proc(in_l)*gout_lin;
o_r = chR.ch_proc(in_r)*gout_lin;
spl0 = o_l; spl1 = o_r;

// published for @gfx, which only READS these scalars
mi = max(abs(in_l), abs(in_r))*gin_lin;
m_in_pk = mi > m_in_pk ? mi : m_in_pk*mtr_fall;
mo = max(abs(o_l), abs(o_r));
m_out_pk = mo > m_out_pk ? mo : m_out_pk*mtr_fall;
ms_in += mtr_a*((in_l*in_l + in_r*in_r)*0.5 - ms_in);
ms_out += mtr_a*((o_l*o_l + o_r*o_r)*0.5 - ms_out);

@gfx 720 248
// ---------------------------------------------------------------------------
// UI THREAD ONLY.  See THREADING at the top.  No audio-side function is
// called from here except recalc().
// ---------------------------------------------------------------------------
gk_begin();
g_chg = 0;

// Shared scale: read it, or seed it if nothing has yet.
gmem[GM_UI_SCALE] > 0 ? gui_scale_idx = gmem[GM_UI_SCALE] - 1
                      : gmem[GM_UI_SCALE] = gui_scale_idx + 1;

// gk_begin set gk_S from gfx_ext_retina (1 or 2).  A fixed percentage is
// relative to that; Fit divides the window by the design size.
g_ret = gk_S;
g_sc = ui_scale(gui_scale_idx);
gk_S = max(0.5, g_sc > 0 ? g_ret * g_sc : min(gfx_w / UI_W, gfx_h / UI_H));
gfx_setfont(1, gk_font, 11*gk_S);
gfx_setfont(2, gk_font, 13*gk_S, 'b');
gfx_setfont(3, gk_font, 9*gk_S);
gfx_setfont(1);

function g_accent(r, g, b) ( gk_ac_r = r; gk_ac_g = g; gk_ac_b = b; );
function g_cyan()   ( g_accent(0.149, 0.784, 0.902); gk_img_button = BTN_CY; );
function g_orange() ( g_accent(0.941, 0.588, 0.157); gk_img_button = BTN_OR; );

function g_count_missing(n) local(i, w, h, bad)
(
  i = 0; bad = 0;
  loop(n, gfx_getimgdim(i, w, h); w <= 0 ? bad += 1; i += 1;);
  bad;
);

function g_rect(x, y, w, h) ( gfx_rect(x*gk_S, y*gk_S, w*gk_S, h*gk_S); );

// Left-aligned text in font 3 at logical x, y.
function g_small(x, y, str)
(
  gfx_setfont(3);
  gfx_x = x*gk_S; gfx_y = y*gk_S;
  gfx_drawstr(str);
  gfx_setfont(1);
);

// Vertical meter, -60..+6 dBFS: the kit bar, a peak-hold line, dB ticks on
// one side and the label underneath.  amp is a linear peak; hold is in dB.
G_MLO = -60; G_MHI = 6; G_MW = 10; G_MY0 = 72; G_MY1 = 188;
function g_meter_y(db) ( G_MY1 - (G_MY1 - G_MY0)*(db - G_MLO)/(G_MHI - G_MLO); );
function g_meter(x, amp, hold, label, right) local(db, tw, th, ty)
(
  db = amp > 0.000001 ? 20*log10(amp) : G_MLO;
  gfx_set(0.102, 0.106, 0.118, 1);
  g_rect(x - 1, G_MY0 - 1, G_MW + 2, G_MY1 - G_MY0 + 2);
  gk_vbar(0, BAR_IMG, x, G_MY0, G_MW, G_MY1 - G_MY0, db, G_MLO, G_MHI);
  hold > G_MLO ? (
    gfx_set(gk_fg_r, gk_fg_g, gk_fg_b, 1);
    g_rect(x, g_meter_y(min(hold, G_MHI)), G_MW, 1);
  );
  gfx_setfont(3);
  gi = 0;
  loop(4,
    g_t = gi == 0 ? 0 : gi == 1 ? -12 : gi == 2 ? -24 : -48;
    ty = g_meter_y(g_t);
    sprintf(#g_n, "%d", g_t);
    gfx_measurestr(#g_n, tw, th);
    gfx_set(0.439, 0.459, 0.494, 1);
    right ? g_rect(x + G_MW + 1, ty, 3, 1) : g_rect(x - 4, ty, 3, 1);
    gfx_set(gk_dim_r, gk_dim_g, gk_dim_b, 1);
    gfx_x = right ? (x + G_MW + 6)*gk_S : (x - 6)*gk_S - tw;
    gfx_y = ty*gk_S - th*0.5;
    gfx_drawstr(#g_n);
    gi += 1;
  );
  gfx_measurestr(label, tw, th);
  gfx_x = (x + G_MW*0.5)*gk_S - tw*0.5;
  gfx_y = (G_MY1 + 4)*gk_S;
  gfx_drawstr(label);
  gfx_setfont(1);
);

// Peak hold, about a second at ~30 frames/s, then it falls 0.5 dB a frame.
function g_hold(amp, hold, tmr) local(db)
(
  db = amp > 0.000001 ? 20*log10(amp) : G_MLO;
  db >= hold ? ( hold = db; g_tmr_out = 30; ) :
    tmr > 0 ? ( hold = hold; g_tmr_out = tmr - 1; ) :
              ( hold = max(hold - 0.5, db); g_tmr_out = 0; );
  hold;
);

// ---------------------------------------------------------------- header
gk_header(0, 10, 10, UI_W - 20, 22, "SATURATOR", -1, 0);
g_r  = min(UI_W - 10, gfx_w/gk_S - 10);
g_cyan();
gk_button(41, g_r - 18, 13, 18, 16, help_open, "?") ? (
  help_open = !help_open;
  help_open && !help_lines ? help_lines = gk_help_load(HELP_FILE, HELP_BASE, HELP_MAX);
);
g_i = gk_dropdown(40, g_r - 88, 13, 64, 16, gui_scale_idx, "Fit|100%|125%|150%|200%",
      gui_scale_idx == 0 ? "Fit"  : gui_scale_idx == 1 ? "100%" :
      gui_scale_idx == 2 ? "125%" : gui_scale_idx == 3 ? "150%" : "200%");
g_i != gui_scale_idx ? ( gui_scale_idx = g_i; gmem[GM_UI_SCALE] = g_i + 1; );
g_oi = min(max(floor(os_i + 0.5), 0), 2);
g_i = gk_dropdown(42, g_r - 146, 13, 48, 16, g_oi, "1x|2x|4x",
      g_oi == 0 ? "1x" : g_oi == 1 ? "2x" : "4x");
g_i != g_oi ? ( os_i = g_i; slider_automate(2^8); g_chg = 1; );
gfx_set(gk_dim_r, gk_dim_g, gk_dim_b, 1);
gfx_measurestr("Oversampling", g_tw, g_th);
gfx_x = (g_r - 152)*gk_S - g_tw; gfx_y = 15*gk_S;
gfx_drawstr("Oversampling");
// Must come after the header controls and before every other widget.
help_open ? gk_help_input(40, 41);

// ---------------------------------------------------------------- panels
// Knob tops at y 74, labels 142, value fields 158, button row 186.
G_KY = 74; G_LY = 142; G_FY = 158; G_RY = 186;

// DRIVE: input meter, Input, Slew
gk_panel(10, 40, 208, 176);
gk_header(0, 10, 40, 208, 22, "DRIVE", -1, 0);
g_cyan();
g_cx = 94;
g_chg |= gk_knob_slider(10, KNOB_CY, g_cx - 32, G_KY, 64, 1, -18, 18, 0);
gk_text_c(g_cx, G_LY, "Input", 1);
sprintf(#g_s, "%+.1f dB", input_db);
g_chg |= gk_field_edit_slider(50, g_cx - 32, G_FY, 64, 16, 1, -18, 18, 0, #g_s);
g_cx = 174;
g_chg |= gk_knob_slider(11, KNOB_CY, g_cx - 32, G_KY, 64, 2, 0, 100, 0);
gk_text_c(g_cx, G_LY, "Slew", 1);
sprintf(#g_s, "%.0f %%", slew);
g_chg |= gk_field_edit_slider(51, g_cx - 32, G_FY, 64, 16, 2, 0, 100, 0, #g_s);

// COLOUR: Asymmetric, Symmetric, Knee
gk_panel(228, 40, 264, 176);
gk_header(0, 228, 40, 264, 22, "COLOUR", -1, 0);
g_orange();
g_cx = 310;
g_chg |= gk_knob_slider(12, KNOB_OR, g_cx - 32, G_KY, 64, 3, 0, 100, 0);
gk_text_c(g_cx, G_LY, "Asymmetric", 1);
sprintf(#g_s, "%.0f %%", asym);
g_chg |= gk_field_edit_slider(52, g_cx - 32, G_FY, 64, 16, 3, 0, 100, 0, #g_s);
g_cx = 410;
g_chg |= gk_knob_slider(13, KNOB_OR, g_cx - 32, G_KY, 64, 4, 0, 100, 0);
gk_text_c(g_cx, G_LY, "Symmetric", 1);
sprintf(#g_s, "%.0f %%", sym);
g_chg |= gk_field_edit_slider(53, g_cx - 32, G_FY, 64, 16, 4, 0, 100, 0, #g_s);
g_ki = min(max(floor(knee + 0.5), 0), 2);
gj = 0;
loop(3,
  gk_button(20 + gj, 270 + 60*gj, G_RY, 60, 18, g_ki == gj,
            gj == 0 ? "Soft" : gj == 1 ? "Medium" : "Hard") ? (
    knee = gj; slider_automate(2^4); g_chg = 1;
  );
  gj += 1;
);

// OUTPUT: Mix, Output, Auto Gain, level change, output meter
gk_panel(502, 40, 208, 176);
gk_header(0, 502, 40, 208, 22, "OUTPUT", -1, 0);
g_cyan();
g_cx = 546;
g_chg |= gk_knob_slider(14, KNOB_CY, g_cx - 32, G_KY, 64, 8, 0, 100, 100);
gk_text_c(g_cx, G_LY, "Mix", 1);
sprintf(#g_s, "%.0f %%", mix);
g_chg |= gk_field_edit_slider(54, g_cx - 32, G_FY, 64, 16, 8, 0, 100, 100, #g_s);
gk_button(23, g_cx - 36, G_RY, 72, 18, auto_gain > 0.5, "Auto Gain") ? (
  auto_gain = auto_gain > 0.5 ? 0 : 1; slider_automate(2^6); g_chg = 1;
);
g_cx = 626;
g_chg |= gk_knob_slider(15, KNOB_CY, g_cx - 32, G_KY, 64, 6, -18, 18, 0);
gk_text_c(g_cx, G_LY, "Output", 1);
sprintf(#g_s, "%+.1f dB", output_db);
g_chg |= gk_field_edit_slider(55, g_cx - 32, G_FY, 64, 16, 6, -18, 18, 0, #g_s);
// Level change, output RMS minus input RMS over ~300 ms; held below -70 dBFS
// so silence does not read as a change.
ms_in > 0.0000001 ? g_delta = 10*log10(max(ms_out, 0.0000000001)/ms_in);
sprintf(#g_s, "Δ %+.1f dB", g_delta);
gk_field(g_cx - 32, G_RY + 1, 64, 16, #g_s);

// meters
g_in_hold = g_hold(m_in_pk, g_in_hold, g_in_tmr);   g_in_tmr = g_tmr_out;
g_out_hold = g_hold(m_out_pk, g_out_hold, g_out_tmr); g_out_tmr = g_tmr_out;
g_meter(22, m_in_pk, g_in_hold, "IN", 1);
g_meter(688, m_out_pk, g_out_hold, "OUT", 0);

// ---------------------------------------------------------------- help
help_open ? gk_help_draw(10, 40, UI_W - 20, UI_H - 64, "Help  -  Saturator",
                         HELP_BASE, help_lines);

// ---------------------------------------------------------------- footer
gfx_set(0.349, 0.369, 0.4, 1);
sprintf(#g_s, "v0.1   latency %d smp", lat_tg);
g_small(10, UI_H - 22, #g_s);
gk_strip(LOGO_IMG, 1, 0, UI_W - 10 - 14*LOGO_ASPECT, UI_H - 24, 14*LOGO_ASPECT, 14);

g_bad = g_count_missing(IMG_COUNT);
g_bad > 0 ? (
  gfx_set(1, 0.42, 0.38, 1);
  gfx_x = 120*gk_S; gfx_y = 15*gk_S;
  gfx_drawstr("images failed to load: ");
  gfx_drawnumber(g_bad, 0);
);

g_chg ? recalc();
gk_end();
