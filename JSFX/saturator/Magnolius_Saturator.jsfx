  ag_row(63,0.0469,0.0504,0.0612,0.0844,0.1256);
  ag_row(64,0.0541,0.0578,0.0692,0.0936,0.1370);
  ag_row(65,0.0214,0.0249,0.0357,0.0589,0.1000);
  ag_row(66,0.0272,0.0307,0.0415,0.0645,0.1056);
  ag_row(67,0.0373,0.0408,0.0515,0.0745,0.1154);
  ag_row(68,0.0502,0.0537,0.0646,0.0877,0.1289);
  ag_row(69,0.0574,0.0611,0.0725,0.0969,0.1403);
  ag_row(70,0.0309,0.0344,0.0452,0.0683,0.1095);
  ag_row(71,0.0367,0.0402,0.0509,0.0740,0.1150);
  ag_row(72,0.0468,0.0502,0.0610,0.0840,0.1248);
  ag_row(73,0.0597,0.0632,0.0740,0.0971,0.1383);
  ag_row(74,0.0668,0.0705,0.0819,0.1063,0.1496);
