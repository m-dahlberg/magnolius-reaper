desc:Variable Ratio Compressor MB (Magnolius)
// @description Variable Ratio Compressor MB (Magnolius)
// @author Magnolius
// @version 1.1
// @link GitHub https://github.com/m-dahlberg/magnolius-reaper
// @about
//   Four-band version of the Variable Ratio Compressor. Each band solves for
//   the ratio that lands its loudest upcoming peak on the ceiling, then holds
//   it across the passage.
//
//   The crossover is a sequential LR4 tree with allpass compensation, so the
//   four bands sum flat - flat magnitude, phase rotation only.
//
//   Note that the ceiling is per band, and four bands each held at the ceiling
//   can sum above it: the ceiling is a shaping control here, not the output
//   level. Use Output Trim for level. A disabled band still runs its delay
//   line, so toggling one never shifts the others in time.
//
//   Licensed GPL-3.0-or-later.
// @changelog
//   Name now ends with (Magnolius) so the plugins are easy to find in the FX browser

// Four-band version of the adaptive-ratio compressor. Each band runs the same
// core: lookahead sliding-max finds the loudest upcoming peak, solves for the
// ratio that lands it on the ceiling, holds that ratio across the passage, then
// a sliding-min + double-boxcar guarantees no overshoot.
//
// CROSSOVER
// Sequential LR4 tree with allpass compensation, so the four bands sum flat:
//   x --LR4(f1)--> L1                                  -> AP(f2) -> AP(f3) -> band 1
//              \-> H1 --LR4(f2)--> L2                  -> AP(f3) -> band 2
//                              \-> H2 --LR4(f3)--> L3  ->           band 3
//                                              \-> H3  ->           band 4
// LR4 lowpass + highpass sums to a 2nd-order allpass at the crossover, so the
// compensating filters are plain Q=0.707 allpass biquads at f2 and f3. The sum
// is AP(f1)*AP(f2)*AP(f3): flat magnitude, phase rotation only.
//
// CEILING
// Ceiling is the per-band target and is shared by all four bands. Four bands
// each held at the ceiling can SUM above it, so the ceiling is a shaping
// control, not the output level -- use Output Trim for that. The safety clip
// sits at 0 dBFS as a last resort, not at the ceiling.
//
// A disabled band still runs its delay line, so bands stay sample-aligned and
// toggling one never shifts the others in time.

slider1:s_in=0<-12,24,0.1>Input Gain (dB)

slider2:s_x1=120<20,500,1>Crossover 1 (Hz)
slider3:s_x2=800<200,3000,1>Crossover 2 (Hz)
slider4:s_x3=5000<1500,16000,10>Crossover 3 (Hz)

slider5:s_ceil=-6<-36,0,0.05>Ceiling (dB, per band)
slider6:s_blend=100<0,100,0.1>Blend (% wet)
slider7:s_trim=0<-20,20,0.1>Output Trim (dB)
slider8:s_mkpos=1<0,1,1{Pre - ceiling holds,Post - ceiling is internal}>Trim Position
slider9:s_clip=1<0,1,1{Off,On}>Safety Clip (0 dBFS)

slider10:s_la=5<0.5,20,0.1>Lookahead (ms)
slider11:s_maxr=200<2,1000,1>Max Ratio (:1)
slider12:s_listen=0<0,4,1{All bands,Band 1 only,Band 2 only,Band 3 only,Band 4 only}>Listen

slider14:s_en1=1<0,1,1{Off,On}>Band 1 Enable
slider15:s_th1=-18<-60,0,0.1>Band 1 Threshold (dB)
slider16:s_rl1=400<10,2000,1>Band 1 Ratio Release (ms)
slider17:s_gn1=0<-20,20,0.1>Band 1 Gain (dB)

slider19:s_en2=1<0,1,1{Off,On}>Band 2 Enable
slider20:s_th2=-18<-60,0,0.1>Band 2 Threshold (dB)
slider21:s_rl2=250<10,2000,1>Band 2 Ratio Release (ms)
slider22:s_gn2=0<-20,20,0.1>Band 2 Gain (dB)

slider24:s_en3=1<0,1,1{Off,On}>Band 3 Enable
slider25:s_th3=-18<-60,0,0.1>Band 3 Threshold (dB)
slider26:s_rl3=150<10,2000,1>Band 3 Ratio Release (ms)
slider27:s_gn3=0<-20,20,0.1>Band 3 Gain (dB)

slider29:s_en4=1<0,1,1{Off,On}>Band 4 Enable
slider30:s_th4=-18<-60,0,0.1>Band 4 Threshold (dB)
slider31:s_rl4=80<10,2000,1>Band 4 Ratio Release (ms)
slider32:s_gn4=0<-20,20,0.1>Band 4 Gain (dB)

in_pin:left
in_pin:right
out_pin:left
out_pin:right

@init

DMAX    = 4096;                  // power of two; 20 ms of lookahead up to 200 kHz
MASK    = DMAX - 1;
BANDSZ  = DMAX * 8;
LN10_20 = 0.11512925464970229;
DB20    = 8.6858896380650366;
BQQ     = 0.70710678118654752;   // Butterworth Q, for both LR4 and the allpasses

// ---------------------------------------------------------------- biquads --

function bq(x) instance(a0, a1, a2, b1, b2, z1, z2) local(y) (
  y  = x * a0 + z1;
  z1 = x * a1 - b1 * y + z2;
  z2 = x * a2 - b2 * y;
  y;
);

function bq_lp(fc, q) instance(a0, a1, a2, b1, b2) local(w, cs, sn, al, n0) (
  w = 2 * $pi * min(fc, srate * 0.45) / srate;
  cs = cos(w); sn = sin(w); al = sn / (2 * q); n0 = 1 + al;
  a0 = (1 - cs) * 0.5 / n0;
  a1 = (1 - cs) / n0;
  a2 = a0;
  b1 = -2 * cs / n0;
  b2 = (1 - al) / n0;
);

function bq_hp(fc, q) instance(a0, a1, a2, b1, b2) local(w, cs, sn, al, n0) (
  w = 2 * $pi * min(fc, srate * 0.45) / srate;
  cs = cos(w); sn = sin(w); al = sn / (2 * q); n0 = 1 + al;
  a0 = (1 + cs) * 0.5 / n0;
  a1 = -(1 + cs) / n0;
  a2 = a0;
  b1 = -2 * cs / n0;
  b2 = (1 - al) / n0;
);

function bq_ap(fc, q) instance(a0, a1, a2, b1, b2) local(w, cs, sn, al, n0) (
  w = 2 * $pi * min(fc, srate * 0.45) / srate;
  cs = cos(w); sn = sin(w); al = sn / (2 * q); n0 = 1 + al;
  a0 = (1 - al) / n0;
  a1 = -2 * cs / n0;
  a2 = 1;
  b1 = -2 * cs / n0;
  b2 = (1 - al) / n0;
);

// ------------------------------------------------------- crossover (1 ch) --

function split_setup(f1, f2, f3) (
  this.l1a.bq_lp(f1, BQQ); this.l1b.bq_lp(f1, BQQ);
  this.h1a.bq_hp(f1, BQQ); this.h1b.bq_hp(f1, BQQ);
  this.l2a.bq_lp(f2, BQQ); this.l2b.bq_lp(f2, BQQ);
  this.h2a.bq_hp(f2, BQQ); this.h2b.bq_hp(f2, BQQ);
  this.l3a.bq_lp(f3, BQQ); this.l3b.bq_lp(f3, BQQ);
  this.h3a.bq_hp(f3, BQQ); this.h3b.bq_hp(f3, BQQ);
  this.ap12.bq_ap(f2, BQQ);   // band 1 compensation
  this.ap13.bq_ap(f3, BQQ);
  this.ap23.bq_ap(f3, BQQ);   // band 2 compensation
);

function split_run(x) instance(b1, b2, b3, b4) local(lo, hi, lo2, hi2) (
  lo  = this.l1b.bq(this.l1a.bq(x));
  hi  = this.h1b.bq(this.h1a.bq(x));
  lo2 = this.l2b.bq(this.l2a.bq(hi));
  hi2 = this.h2b.bq(this.h2a.bq(hi));
  b3  = this.l3b.bq(this.l3a.bq(hi2));
  b4  = this.h3b.bq(this.h3a.bq(hi2));
  b1  = this.ap13.bq(this.ap12.bq(lo));
  b2  = this.ap23.bq(lo2);
);

// ------------------------------------------------------- band compressor --

function band_setup(base)
  instance(dlyL, dlyR, mxv, mxi, mnv, mni, ma1, ma2) (
  dlyL = base;
  dlyR = base + DMAX;
  mxv  = base + DMAX * 2;
  mxi  = base + DMAX * 3;
  mnv  = base + DMAX * 4;
  mni  = base + DMAX * 5;
  ma1  = base + DMAX * 6;
  ma2  = base + DMAX * 7;
);

function band_reset()
  instance(dlyL, ma1, ma2, sum1, sum2, b1p, b2p,
           mxh, mxt, mxc, mnh, mnt, mnc, n, wp, rp, rs, gs) (
  memset(dlyL, 0, DMAX * 2);          // dlyL and dlyR are contiguous
  memset(ma1, 1, DMAX);
  memset(ma2, 1, DMAX);
  sum1 = box; sum2 = box;
  b1p = 0; b2p = 0;
  mxh = 0; mxt = 0; mxc = 0;
  mnh = 0; mnt = 0; mnc = 0;
  n = 0; wp = 0; rp = DMAX - la;
  rs = 1; gs = 1;
);

function band_run(l, r, en, thr_db, rc)
  instance(dlyL, dlyR, mxv, mxi, mnv, mni, ma1, ma2,
           wp, rp, n, mxh, mxt, mxc, mnh, mnt, mnc,
           b1p, b2p, sum1, sum2, rs, gs, outL, outR, inL, inR)
  local(a, pk, pk_db, greq, gdb, den, rden, rt, a_db, g, gm, s1) (

  dlyL[wp] = l;
  dlyR[wp] = r;
  a = max(abs(l), abs(r));

  // sliding maximum over the lookahead window
  while (mxc > 0 && mxv[(mxt + MASK) & MASK] <= a) ( mxt = (mxt + MASK) & MASK; mxc -= 1; );
  mxv[mxt] = a; mxi[mxt] = n; mxt = (mxt + 1) & MASK; mxc += 1;
  while (mxi[mxh] <= n - W) ( mxh = (mxh + 1) & MASK; mxc -= 1; );
  pk = mxv[mxh];

  // ratio that lands the upcoming peak exactly on the ceiling
  rt = 1;
  (en && pk > 0.0000001) ? (
    pk_db = log(pk) * DB20;
    pk_db > thr_db ? (
      greq = blend > 0.0001 ? (ceil_lin / pk - (1 - blend)) / (blend * mk_pre) : 2;
      greq < 1 ? (
        greq < 0.000001 ? greq = 0.000001;
        gdb  = log(greq) * DB20;
        den  = pk_db - thr_db;
        rden = 1 + gdb / den;
        rt   = rden > 0.000001 ? 1 / rden : maxr;
        rt > maxr ? rt = maxr;
        rt < 1    ? rt = 1;
      );
    );
  );

  rt > rs ? rs = rt : rs = rt + (rs - rt) * rc;

  g = 1;
  (en && a > 0.0000001) ? (
    a_db = log(a) * DB20;
    a_db > thr_db ? ( g = exp( -(a_db - thr_db) * (1 - 1/rs) * LN10_20 ); );
  );

  // sliding minimum of the gain, then two boxcars
  while (mnc > 0 && mnv[(mnt + MASK) & MASK] >= g) ( mnt = (mnt + MASK) & MASK; mnc -= 1; );
  mnv[mnt] = g; mni[mnt] = n; mnt = (mnt + 1) & MASK; mnc += 1;
  while (mni[mnh] <= n - W) ( mnh = (mnh + 1) & MASK; mnc -= 1; );
  gm = mnv[mnh];

  b1p += 1; b1p >= box ? b1p = 0;
  sum1 += gm - ma1[b1p]; ma1[b1p] = gm;
  s1 = sum1 / box;

  b2p += 1; b2p >= box ? b2p = 0;
  sum2 += s1 - ma2[b2p]; ma2[b2p] = s1;
  gs = sum2 / box;
  gs > 1 ? gs = 1;
  gs < 0 ? gs = 0;

  inL = dlyL[rp];
  inR = dlyR[rp];

  en ? (
    outL = inL * (1 - blend) + inL * gs * mk_pre * blend;
    outR = inR * (1 - blend) + inR * gs * mk_pre * blend;
  ) : (
    outL = inL; outR = inR;          // bypassed, but still delayed
  );

  wp += 1; wp >= DMAX ? wp = 0;
  rp += 1; rp >= DMAX ? rp = 0;
  n  += 1;
);

// ------------------------------------------------------------- allocation --

bnd1.band_setup(0 * BANDSZ);
bnd2.band_setup(1 * BANDSZ);
bnd3.band_setup(2 * BANDSZ);
bnd4.band_setup(3 * BANDSZ);

HIST  = 1024;
HMASK = HIST - 1;
hIMIN = 4 * BANDSZ;
hIMAX = hIMIN + HIST;
hOMIN = hIMAX + HIST;
hOMAX = hOMIN + HIST;
hG    = hOMAX + HIST;            // 4 * HIST, band-major
hR    = hG    + 4 * HIST;        // 4 * HIST
binG  = hR    + 4 * HIST;        // 4
binR  = binG  + 4;               // 4
bthr  = binR  + 4;               // 4
ben   = bthr  + 4;               // 4
brelc = ben   + 4;               // 4
bgain = brelc + 4;               // 4

binlen = max(1, floor(srate * 0.005));   // 5 ms per display column

lastla     = -1;
need_reset = 1;
mtr        = 1;
rmtr       = 1;

@slider

ig       = exp(s_in * LN10_20);
blend    = s_blend * 0.01;
maxr     = s_maxr;
ceil_lin = exp(s_ceil * LN10_20);

trim = exp(s_trim * LN10_20);
// Pre folds the trim into every band's ratio solve, so the band ceilings still
// hold after it. Post applies it once to the summed output instead.
s_mkpos == 0 ? ( mk_pre = trim; mk_post = 1; ) : ( mk_pre = 1; mk_post = trim; );

// keep the crossovers ordered and inside Nyquist
f1 = s_x1;
f2 = max(s_x2, f1 * 1.1);
f3 = max(s_x3, f2 * 1.1);
f3 = min(f3, srate * 0.45);
f2 = min(f2, f3 / 1.1);
f1 = min(f1, f2 / 1.1);

L.split_setup(f1, f2, f3);
R.split_setup(f1, f2, f3);

la = floor(s_la * 0.001 * srate + 0.5);
la < 1 ? la = 1;
la > DMAX - 8 ? la = DMAX - 8;
W   = la + 1;
box = max(1, floor(la * 0.5));

ben[0]  = s_en1; ben[1]  = s_en2; ben[2]  = s_en3; ben[3]  = s_en4;
bthr[0] = s_th1; bthr[1] = s_th2; bthr[2] = s_th3; bthr[3] = s_th4;
brelc[0] = exp(-1 / max(1, s_rl1 * 0.001 * srate));
brelc[1] = exp(-1 / max(1, s_rl2 * 0.001 * srate));
brelc[2] = exp(-1 / max(1, s_rl3 * 0.001 * srate));
brelc[3] = exp(-1 / max(1, s_rl4 * 0.001 * srate));

// Per-band gain compensation, applied to the band output after compression and
// before the sum. Like the global Post trim, it deliberately sits outside the
// ratio solve, so it lifts the band past the ceiling rather than driving the
// compressor harder.
bgain[0] = exp(s_gn1 * LN10_20);
bgain[1] = exp(s_gn2 * LN10_20);
bgain[2] = exp(s_gn3 * LN10_20);
bgain[3] = exp(s_gn4 * LN10_20);

pdc_delay  = la;
pdc_bot_ch = 0;
pdc_top_ch = 2;
ext_tail_size = la + srate * 0.5;

la != lastla ? ( lastla = la; need_reset = 1; );

need_reset ? (
  bnd1.band_reset(); bnd2.band_reset();
  bnd3.band_reset(); bnd4.band_reset();

  memset(hIMIN, 0, HIST * 4);        // hIMIN..hOMAX are contiguous
  memset(hG, 1, HIST * 8);           // hG and hR are contiguous
  memset(binG, 1, 8);
  hw = 0; binN = 0;
  binIMin = 0; binIMax = 0; binOMin = 0; binOMax = 0;

  need_reset = 0;
);

@sample

l = spl0 * ig;
r = spl1 * ig;

L.split_run(l);
R.split_run(r);

bnd1.band_run(L.b1, R.b1, ben[0], bthr[0], brelc[0]);
bnd2.band_run(L.b2, R.b2, ben[1], bthr[1], brelc[1]);
bnd3.band_run(L.b3, R.b3, ben[2], bthr[2], brelc[2]);
bnd4.band_run(L.b4, R.b4, ben[3], bthr[3], brelc[3]);

s_listen == 0 ? (
  ol  = bnd1.outL * bgain[0] + bnd2.outL * bgain[1]
      + bnd3.outL * bgain[2] + bnd4.outL * bgain[3];
  orr = bnd1.outR * bgain[0] + bnd2.outR * bgain[1]
      + bnd3.outR * bgain[2] + bnd4.outR * bgain[3];
) : s_listen == 1 ? ( ol = bnd1.outL * bgain[0]; orr = bnd1.outR * bgain[0]; )
  : s_listen == 2 ? ( ol = bnd2.outL * bgain[1]; orr = bnd2.outR * bgain[1]; )
  : s_listen == 3 ? ( ol = bnd3.outL * bgain[2]; orr = bnd3.outR * bgain[2]; )
  : ( ol = bnd4.outL * bgain[3]; orr = bnd4.outR * bgain[3]; );

ol  *= mk_post;
orr *= mk_post;

s_clip ? (
  ol  = max(-1, min(1, ol));
  orr = max(-1, min(1, orr));
);

spl0 = ol;
spl1 = orr;

// -------------------------------------------------------------- metering --

gmin = min(min(bnd1.gs, bnd2.gs), min(bnd3.gs, bnd4.gs));
rmax = max(max(bnd1.rs, bnd2.rs), max(bnd3.rs, bnd4.rs));
gmin < mtr  ? mtr  = gmin : mtr  = gmin + (mtr  - gmin) * 0.9995;
rmax > rmtr ? rmtr = rmax : rmtr = rmax + (rmtr - rmax) * 0.9995;

// summed pre-compression input, rebuilt from the delayed band inputs so it
// lines up sample for sample with the output on the scope
dinL = bnd1.inL + bnd2.inL + bnd3.inL + bnd4.inL;
dinR = bnd1.inR + bnd2.inR + bnd3.inR + bnd4.inR;

dhi = max(dinL, dinR); dlo = min(dinL, dinR);
dhi > binIMax ? binIMax = dhi;
dlo < binIMin ? binIMin = dlo;

dhi = max(ol, orr); dlo = min(ol, orr);
dhi > binOMax ? binOMax = dhi;
dlo < binOMin ? binOMin = dlo;

bnd1.gs < binG[0] ? binG[0] = bnd1.gs;
bnd2.gs < binG[1] ? binG[1] = bnd2.gs;
bnd3.gs < binG[2] ? binG[2] = bnd3.gs;
bnd4.gs < binG[3] ? binG[3] = bnd4.gs;
bnd1.rs > binR[0] ? binR[0] = bnd1.rs;
bnd2.rs > binR[1] ? binR[1] = bnd2.rs;
bnd3.rs > binR[2] ? binR[2] = bnd3.rs;
bnd4.rs > binR[3] ? binR[3] = bnd4.rs;

binN += 1;
binN >= binlen ? (
  hIMIN[hw] = binIMin; hIMAX[hw] = binIMax;
  hOMIN[hw] = binOMin; hOMAX[hw] = binOMax;
  hG[hw] = binG[0]; hG[HIST + hw] = binG[1];
  hG[HIST * 2 + hw] = binG[2]; hG[HIST * 3 + hw] = binG[3];
  hR[hw] = binR[0]; hR[HIST + hw] = binR[1];
  hR[HIST * 2 + hw] = binR[2]; hR[HIST * 3 + hw] = binR[3];
  hw = (hw + 1) & HMASK;
  binN = 0;
  binIMin = 0; binIMax = 0; binOMin = 0; binOMax = 0;
  memset(binG, 1, 8);
);

@gfx 760 420

gfx_set(0.07, 0.07, 0.08, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

padl = 8; padr = 8; padt = 22; padb = 18;
plotx  = padl;
plotw  = max(32, gfx_w - padl - padr);
totalh = max(140, gfx_h - padt - padb);
wavh   = floor(totalh * 0.40);
laneh  = floor((totalh - wavh) / 4);

GRRANGE = 24;
lmaxr = log(max(maxr, 2));
cols  = min(plotw, HIST - 2);

// ------------------------------------------------- summed waveform panel --

ploty = padt;
cy = ploty + wavh * 0.5;

gfx_set(0.11, 0.11, 0.13, 1);
gfx_rect(plotx, ploty, plotw, wavh);
gfx_set(0.18, 0.18, 0.21, 1);
gfx_line(plotx, cy, plotx + plotw, cy);

i = 0;
while (i < cols) (
  ci = (hw - 1 - i) & HMASK;
  px = plotx + plotw - 1 - i;

  y0 = max(ploty, min(ploty + wavh, cy - hIMAX[ci] * wavh * 0.5));
  y1 = max(ploty, min(ploty + wavh, cy - hIMIN[ci] * wavh * 0.5));
  gfx_set(0.26, 0.30, 0.38, 1);
  gfx_line(px, y0, px, y1);

  y0 = max(ploty, min(ploty + wavh, cy - hOMAX[ci] * wavh * 0.5));
  y1 = max(ploty, min(ploty + wavh, cy - hOMIN[ci] * wavh * 0.5));
  gfx_set(0.52, 0.70, 0.92, 1);
  gfx_line(px, y0, px, y1);

  i += 1;
);

// ------------------------------------------------------------ band lanes --

b = 0;
while (b < 4) (
  lany  = padt + wavh + b * laneh;
  onoff = ben[b];

  gfx_set(0.10, 0.10, 0.12, 1);
  gfx_rect(plotx, lany + 1, plotw, laneh - 2);
  gfx_set(0.17, 0.17, 0.20, 1);
  gfx_line(plotx, lany, plotx + plotw, lany);

  // gain reduction, hanging from the lane top
  onoff ? gfx_set(0.98, 0.58, 0.18, 1) : gfx_set(0.30, 0.30, 0.32, 1);
  i = 0; havep = 0;
  while (i < cols) (
    ci = (hw - 1 - i) & HMASK;
    px = plotx + plotw - 1 - i;
    v = -log(max(hG[b * HIST + ci], 0.000001)) * DB20;
    v > GRRANGE ? v = GRRANGE;
    py = lany + 1 + v / GRRANGE * (laneh - 2);
    havep ? gfx_line(px, py, ppx, ppy);
    ppx = px; ppy = py; havep = 1;
    i += 1;
  );

  // ratio, rising from the lane bottom on a log scale
  onoff ? gfx_set(0.34, 0.86, 0.62, 1) : gfx_set(0.26, 0.28, 0.27, 1);
  i = 0; havep = 0;
  while (i < cols) (
    ci = (hw - 1 - i) & HMASK;
    px = plotx + plotw - 1 - i;
    v = log(max(hR[b * HIST + ci], 1)) / lmaxr;
    v > 1 ? v = 1;
    py = lany + laneh - 1 - v * (laneh - 2);
    havep ? gfx_line(px, py, ppx, ppy);
    ppx = px; ppy = py; havep = 1;
    i += 1;
  );

  // lane label
  onoff ? gfx_set(0.72, 0.72, 0.78, 0.9) : gfx_set(0.36, 0.36, 0.40, 0.9);
  gfx_x = plotx + 5; gfx_y = lany + 3;
  gfx_drawstr("B");
  gfx_drawnumber(b + 1, 0);
  onoff == 0 ? gfx_drawstr(" off");
  gd = log(bgain[b]) * DB20;
  abs(gd) > 0.05 ? (
    gfx_drawstr("  ");
    gd > 0 ? gfx_drawstr("+");
    gfx_drawnumber(gd, 1);
    gfx_drawstr(" dB");
  );

  b += 1;
);

// ---------------------------------------------------------------- header --

gfx_set(0.52, 0.70, 0.92, 1);
gfx_x = padl; gfx_y = 5; gfx_drawstr("out");
gfx_set(0.26, 0.30, 0.38, 1); gfx_drawstr(" / in");

gfx_set(0.98, 0.58, 0.18, 1);
gfx_x = padl + 70; gfx_y = 5;
gfx_drawstr("GR ");
gfx_drawnumber(-log(max(mtr, 0.000001)) * DB20, 1);
gfx_drawstr(" dB");

gfx_set(0.34, 0.86, 0.62, 1);
gfx_x = padl + 190; gfx_y = 5;
gfx_drawstr("ratio ");
gfx_drawnumber(rmtr, 1);
gfx_drawstr(":1");

gfx_set(0.45, 0.45, 0.50, 1);
gfx_x = padl + 530; gfx_y = 5;
gfx_drawnumber(f1, 0); gfx_drawstr(" / ");
gfx_drawnumber(f2, 0); gfx_drawstr(" / ");
gfx_drawnumber(f3, 0); gfx_drawstr(" Hz");

s_listen > 0 ? (
  gfx_set(0.95, 0.80, 0.30, 1);
  gfx_x = padl + 470; gfx_y = 5;
  gfx_drawstr("LISTEN B");
  gfx_drawnumber(s_listen, 0);
);

gfx_set(0.45, 0.45, 0.50, 1);
gfx_x = padl; gfx_y = padt + totalh + 3;
gfx_drawnumber(cols * binlen / srate, 1);
gfx_drawstr(" s");
