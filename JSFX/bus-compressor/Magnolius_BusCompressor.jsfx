desc:Bus Compressor (Magnolius)
// @description Bus Compressor (Magnolius)
// @author Magnolius
// @version 0.2
// @link GitHub https://github.com/m-dahlberg/magnolius-reaper
// @provides
//   gui_kit/gui_kit.jsfx-inc
//   gui_kit/*.png
//   Magnolius_BusCompressor.help.txt
// @about
//   A stereo bus compressor modelled on a classic feedback VCA design: the
//   detector hears the gain-reduced signal, attack and release come from one
//   shared RC network, and an Auto release follows the programme with two
//   coupled capacitors. Stepped controls, stereo linked. Adds a sidechain
//   high-pass, an external key, dry/wet, and a light Colour stage whose drive
//   follows the gain reduction.
//
//   Constant 24 samples of latency, reported to the host (PDC).
//
//   Licensed GPL-3.0-or-later.
// @changelog
//   0.2 Feedback detector and RC timing network in place of the feed-forward
//       gain computer; new backlit gain-reduction meter (0-15 dB, 0 on the
//       right); Colour leans to 3rd harmonic.
//   0.1 First release.

//tags: dynamics compressor bus glue console
// A behavioural model of a classic feedback VCA bus compressor - the same
// structure and stepped controls, not a circuit simulation.  Everything
// marked INFERRED is a modelling decision, not a published figure.
//
// Signal path (per sample):
//   key     = the input, or the external key on channels 3/4
//   key     -> 2nd-order Butterworth HPF (the detector only, never the audio)
//   a       = max(|L|,|R|) * (the gain of the previous sample): the detector
//             hears the gain-REDUCED signal.  That feedback, not a gain
//             computer, shapes the static curve.
//   rectifier  Vr = K * a^eta, linear in amplitude.  The Ratio switch sets
//             eta, so the effective ratio rises with the gain reduction.
//   -> ONE shared RC timing network whose state is the gain reduction in dB:
//        the diode only CHARGES the capacitor, through the Attack resistor;
//        it discharges through the Release resistor and a 3M3 bleed, so a
//        slow attack with a fast release settles at only R_rel/(R_att+R_rel)
//        of Vr, and release can be faster than attack.
//        Auto    : two coupled capacitors, (0.47 uF || 91k) in series with
//                  (6.8 uF || 750k).  A transient lands on the small one and
//                  recovers fast; sustained compression migrates to the big
//                  one and recovers over seconds.  No switch, no crossfade.
//   -> VCA gain on the input (the same gain on both channels)
//   -> Colour: a polynomial shaper run 2x oversampled, evaluated at the
//        PRE-compression level (so the harmonics follow the input level) with
//        a drive that follows the gain reduction.  Crossfaded against a plain
//        delay of the same length, so Colour 0 is bit-transparent.
//   -> makeup (wet path only) -> dry/wet -> bypass -> key listen
//
// LATENCY is a constant LAT = 24 samples (the 49-tap halfband pair), reported
// through pdc_delay whatever the settings.  The dry path, the bypass path and
// the Colour-off path are each delayed by the same 24 samples, so actual
// latency always equals reported latency and toggling anything never shifts
// timing.  The detector and the gain run on the UNDELAYED input.
//
// INFERRED constants (plain numbers in @init, tune by ear): U_REF, VR_CAP,
// GR_MAX, the eta rule, SAT_*.  The attack and release LABELS are nominal:
// the RC values set the time, and the closed loop speeds the attack up.
//
// Every slider label starts with '-', which hides it from REAPER's generic
// slider list (the panel replaces it) while keeping it automatable.
//
// THREADING - do not undo this.  @gfx runs on the UI thread; @init, @slider,
// @block and @sample run on the audio thread.  ALL globals AND all function
// locals and parameters are shared and static.  So:
//   * every @gfx variable is g_-prefixed; @gfx loop counters are gi/gj; the
//     audio side never uses a g_ name, gi or gj; nothing is named on both.
//   * audio thread only:  fir, shape, hp_design, ramp, snap, proc_ch,
//     kaiser_i0, halfband_init, timing_design
//   * @gfx only:          every g_* function and every gk_* widget
//   * the ONE function both threads call is recalc().  It has no parameters,
//     no local() and no loops - every name in it is a global written
//     deterministically from the slider values - so two concurrent calls
//     compute identical results.  It must be callable from @gfx because
//     neither slider_automate() nor sliderchange() re-runs @slider, and
//     @block does not run on a stopped track.  DO NOT ADD locals, parameters
//     or loops to it.
// EEL2 is case-insensitive, and has no scientific notation (1e-9 is a silent
// syntax error that kills the whole section).
//
// tools/model.py mirrors @init / recalc / @sample sample for sample.  Edit
// the two together.
//
// Shared memory, namespaced to this vendor.  ONE slot map for every
// options:gmem=Magnolius plugin:
//   gmem[0]  interface scale, as index+1 (0 = not set yet)
//
// Memory map (words):
//    0.. 12  halfband taps c_tab[1..12]
//   16.. 21  attack resistors, 24.. 27  release resistors (ohms)
//   32.. 34  eta per ratio,    36.. 38  mean of |sin|^eta per ratio
//   40.. 43  Auto 2x2 update, diode on     44.. 47  diode off
//   64      dry L        128  dry R         (rings of 64, indexed & 63)
//   192     VCA'd L      256  VCA'd R       (the oversampler input)
//   320     shaped even L 384 shaped even R
//   448     shaped odd L  512 shaped odd R
//   576     drive ring   640  1/gain ring
//   704.. 707  DC blocker state L, R
//
// Registries:  widget ids  10-14 compressor knobs, 15-17 second-row knobs,
//              21-22 toggles, 40-42 header controls, 50-56 value fields.
//              string slots 300+ help text.

slider1:thr_db=-10<-40,0,0.1>-Threshold (dBFS)
slider2:ratio_i=1<0,2,1{2,4,10}>-Ratio
slider3:att_i=4<0,5,1{0.1,0.3,1,3,10,30}>-Attack (ms)
slider4:rel_i=1<0,4,1{0.1,0.3,0.6,1.2,Auto}>-Release (s)
slider5:makeup_db=0<0,20,0.1>-Makeup (dB)
slider6:hpf_hz=0<0,500,1>-Sidechain HPF (Hz)
slider7:ext_key=0<0,1,1{Off,On}>-External Key
slider8:key_listen=0<0,1,1{Off,On}>-Listen to Key
slider9:colour=0<0,100,1>-Colour (%)
slider10:mix=100<0,100,1>-Dry Wet Mix (%)
slider11:bypass=0<0,1,1{Off,On}>-Bypass

options:gmem=Magnolius

in_pin:left input
in_pin:right input
in_pin:left key
in_pin:right key
out_pin:left output
out_pin:right output

import gui_kit/gui_kit.jsfx-inc

// Images first and contiguous from 0, the help file LAST.  Never put a
// trailing // comment on these lines: the rest of the line is the path.
filename:0,gui_kit/knob_cyan_grid.png
filename:1,gui_kit/knob_orange_grid.png
filename:2,gui_kit/value_field.png
filename:3,gui_kit/header_bar.png
filename:4,gui_kit/panel_tile.png
filename:5,gui_kit/dropdown.png
filename:6,gui_kit/button_cyan.png
filename:7,gui_kit/toggle_orange.png
filename:8,gui_kit/logo_magnolius_grey.png
filename:9,gui_kit/meter_face.png
filename:10,Magnolius_BusCompressor.help.txt

@init
gk_init();
gk_img_field = 2; gk_img_header = 3; gk_img_panel = 4;
gk_img_dropdown = 5; gk_img_button = 6;
IMG_COUNT = 10;                 // slots 0..9 are images; 10 is the help file
TOG_IMG = 7;
LOGO_IMG = 8;
METER_IMG = 9;
LOGO_ASPECT = 512/101;

// Grid-packed filmstrip: 8 columns x 8 rows, 64 frames (cyan and orange).
gk_knob_cols = 8; gk_knob_frames = 64;

// ---- design size ----
// REAPER opens at the @gfx size, which is a compile-time literal, so keep
// these in step with the "@gfx 720 360" line.
UI_W = 720; UI_H = 360;

// ---- interface scale ----
GM_UI_SCALE = 0;
UI_SCALE_DEFAULT = 0;           // 0 = Fit, else an entry in ui_scale()
function ui_scale(idx) ( idx == 1 ? 1 : idx == 2 ? 1.25 : idx == 3 ? 1.5 : idx == 4 ? 2 : 0; );

// ---- help ----
HELP_FILE = 10; HELP_BASE = 300; HELP_MAX = 600;

// ---- constants ----
DB2LOG  = 0.11512925464970229;  // ln(10)/20
LOG2DB  = 8.6858896380650366;   // 20/ln(10)
TINY_A  = 10^(-6);              // amplitude floor, -120 dB.  NOT 1e-6.
A_FLOOR = 10^(-10);             // below this the rectifier reads nothing
// The RC network, in ohms and farads.
C_T     = 0.00000047;           // timing capacitor, 0.47 uF
R_BLEED = 3300000;              // always on the node
R_A1    = 91000;   C_A1 = 0.00000047;   // Auto, fast section
R_A2    = 750000;  C_A2 = 0.0000068;    // Auto, slow section
// INFERRED constants - see the header.
U_REF    = 1;                   // dB of GR a steady sine at Threshold gives
VR_CAP   = 100;                 // dB, rectifier output limit
GR_MAX   = 30;                  // dB, the control line cannot go further
ETA_PR   = 1.15129254649702;    // eta = (ratio - 1)/ETA_PR: the slope at 10 dB GR
M_N      = 1024;                // points for the mean of |sin|^eta
SM_T     = 0.020;               // s, makeup / mix / colour smoothing
RAMP_T   = 0.010;               // s, bypass / listen / Colour-switch ramps
HP_BLK   = 32;                  // samples between HPF coefficient updates
HP_OFF_HZ = 10;                 // the filter parks here while Off
HP_GLIDE_T = 0.020;             // s, cutoff glide
SAT_A2   = 0.01;                // 2nd-order shaper term (a trimmed VCA nulls it)
SAT_A3   = 0.20;                // 3rd-order shaper term
SAT_BASE = 0.25;                // share of the drive present with no GR
SAT_GR_FULL = 10;               // dB of GR at which the drive is full
SAT_REF2 = 0.20;                // squared amplitude the gain trim assumes
DC_HZ    = 8;                   // DC blocker corner after the shaper
MTR_T    = 0.025;               // s, each of the two needle poles
MTR_PK   = 0.300;               // s, in/out peak fall
KAISER_BETA = 8;
LAT      = 24;                  // samples; the 49-tap halfband pair

// memory map
c_tab   = 0;
ra_tab  = 16;
rr_tab  = 24;
eta_tab = 32;
m_tab   = 36;
EC_ON   = 40;  EC_OFF = 44;
R_DRYL = 64;  R_DRYR = 128;
R_XGL  = 192; R_XGR  = 256;
R_ZEL  = 320; R_ZER  = 384;
R_ZOL  = 448; R_ZOR  = 512;
R_DD   = 576; R_SC   = 640;
R_DCL  = 704; R_DCR  = 706;

// Attack 0.1 0.3 1 3 10 30 ms: 820R 2k7 8k2 27k 82k 270k into 0.47 uF.
ra_tab[0] = 820;   ra_tab[1] = 2700;  ra_tab[2] = 8200;
ra_tab[3] = 27000; ra_tab[4] = 82000; ra_tab[5] = 270000;
// Release 0.1 0.3 0.6 1.2 s: 180k 270k 560k 1M2 in parallel with 0.47 uF;
// index 4 = Auto, which has its own network.
rr_tab[0] = 180000; rr_tab[1] = 270000; rr_tab[2] = 560000; rr_tab[3] = 1200000;

ext_gr_meter = 0;

// Everything derived from the sliders and srate, in one place.  Called from
// @slider, from @init and from @gfx.
//
// *** DO NOT ADD local() OR PARAMETERS OR LOOPS TO THIS FUNCTION. ***
// See THREADING.
function recalc()
(
  r_k = min(max(floor(ratio_i + 0.5), 0), 2);
  a_k = min(max(floor(att_i + 0.5), 0), 5);
  l_k = min(max(floor(rel_i + 0.5), 0), 4);
  eta = eta_tab[r_k];
  // Vr = vr_k*exp(eta*(ln a - lref)): a steady sine of peak thr_db averages
  // to U_REF dB of Vr, before the divider.
  lref = DB2LOG*(thr_db - U_REF);
  vr_k = U_REF/m_tab[r_k];
  sm_a = 1 - exp(-1/(SM_T*srate));
  ramp_s = 1/(RAMP_T*srate);
  mk_t = makeup_db;
  mix_t = mix*0.01;
  col_t = colour*0.01;
  sat_t = colour > 0 ? 1 : 0;
  bp_t = bypass > 0.5 ? 1 : 0;
  ls_t = key_listen > 0.5 ? 1 : 0;
  ext_on = ext_key > 0.5;
  hp_on = hpf_hz >= 20;
  hp_tgt = log(hp_on ? hpf_hz : HP_OFF_HZ);
  hp_a = 1 - exp(-1/(HP_GLIDE_T*srate/HP_BLK));
  dc_r = 1 - 2*$pi*DC_HZ/srate;
  m_a = 1 - exp(-1/(MTR_T*srate));
  m_pk = exp(-1/(MTR_PK*srate));
);

// eta per ratio and the mean of |sin|^eta over a half cycle (what a slow
// detector averages a sine to).  Called from @init only.
function tables_init() local(r, k, tot, ratio)
(
  r = 0;
  loop(3,
    ratio = r == 0 ? 2 : r == 1 ? 4 : 10;
    eta_tab[r] = (ratio - 1)/ETA_PR;
    tot = 0; k = 0;
    loop(M_N, tot += sin($pi*(k + 0.5)/M_N)^eta_tab[r]; k += 1;);
    m_tab[r] = tot/M_N;
    r += 1;
  );
);

// Kaiser-windowed halfband, 49 taps: the centre tap is 0.5, every other tap
// at an even distance from it is zero, and the 12 distinct odd-offset taps
// c_tab[1..12] are scaled so the DC gain is exactly 1.
function kaiser_i0(x) local(s, t, k)
(
  s = 1; t = 1; k = 1;
  loop(25, t *= sqr(x*0.5/k); s += t; k += 1;);
  s;
);
function halfband_init() local(b0, i, j, w, tot)
(
  b0 = kaiser_i0(KAISER_BETA);
  tot = 0; i = 1;
  loop(12,
    j = 2*i - 1;
    w = kaiser_i0(KAISER_BETA*sqrt(1 - sqr(j/24)))/b0;
    c_tab[i] = sin($pi*j*0.5)/($pi*j)*w;
    tot += c_tab[i];
    i += 1;
  );
  i = 1;
  loop(12, c_tab[i] *= 0.25/tot; i += 1;);
);

// Second-order Butterworth high-pass, bilinear.  AUDIO THREAD ONLY.
function hp_design(f) local(k, nrm)
(
  f = min(f, srate*0.45);
  k = tan($pi*f/srate);
  nrm = 1/(1 + 1.41421356237309505*k + k*k);
  hb0 = nrm; hb1 = -2*nrm; hb2 = nrm;
  ha1 = 2*(k*k - 1)*nrm;
  ha2 = (1 - 1.41421356237309505*k + k*k)*nrm;
);

// The RC timing network for the current Attack / Release and sample rate,
// integrated exactly over one sample for each diode state.  AUDIO THREAD
// ONLY.  Also carries the node voltage across a fixed <-> Auto change, so a
// release switch never resets the envelope.
//
// Fixed release, one state V (dB of GR):  V' = e*V + f*Vr   (diode on)
//                                         V' = e_off*V      (diode off)
// Auto, x = [vc1, vc2], dx/dt = A x + b Vr.  A is 2x2 with real eigenvalues,
// so exp(A h) = e^(m h) (cosh(s h) I + sinh(s h)/s (A - m I)); the update is
// x' = E x + F Vr, with E in EC_ON / EC_OFF and F = f1, f2 (diode on only).
function timing_design() local(h, ra, rr, rp, ton, d1, d2, mode, g, a11, a12, a21, a22,
                              mm, sg, ep, em, ch, sh, ec, b1, b2, dt, x1, x2)
(
  h = 1/srate;
  ra = ra_tab[a_k];
  c_l != 4 && l_k == 4 ? (
    vc1 = v*C_A2/(C_A1 + C_A2);           // series capacitors: equal charge
    vc2 = v - vc1;
  ) : c_l == 4 && l_k != 4 ? (
    v = vc1 + vc2;
  );
  c_a = a_k; c_l = l_k;
  rr = rr_tab[min(l_k, 3)];
  rp = rr*R_BLEED/(rr + R_BLEED);
  ton = ra*rp/(ra + rp)*C_T;
  e_on = exp(-h/ton);
  f_on = (1 - e_on)*rp/(ra + rp);
  e_off = exp(-h/(rp*C_T));
  d1 = 1/(R_A1*C_A1);
  d2 = 1/(R_A2*C_A2);
  mode = 0;
  loop(2,
    g = (mode == 0 ? 1/ra : 0) + 1/R_BLEED;
    a11 = -g/C_A1 - d1; a12 = -g/C_A1;
    a21 = -g/C_A2;      a22 = -g/C_A2 - d2;
    mm = 0.5*(a11 + a22);
    sg = sqrt(sqr(0.5*(a11 - a22)) + a12*a21);
    ep = exp((mm + sg)*h); em = exp((mm - sg)*h);
    ch = 0.5*(ep + em);
    sh = (ep - em)/(2*sg);
    ec = mode == 0 ? EC_ON : EC_OFF;
    ec[0] = ch + sh*(a11 - mm);  ec[1] = sh*a12;
    ec[2] = sh*a21;              ec[3] = ch + sh*(a22 - mm);
    mode == 0 ? (
      b1 = 1/(ra*C_A1); b2 = 1/(ra*C_A2);
      dt = a11*a22 - a12*a21;
      x1 = -(a22*b1 - a12*b2)/dt;         // steady state per unit Vr
      x2 = -(-a21*b1 + a11*b2)/dt;
      f1 = (1 - ec[0])*x1 - ec[1]*x2;
      f2 = -ec[2]*x1 + (1 - ec[3])*x2;
    );
    mode += 1;
  );
);

initdone != 20261024 ? (
  initdone = 20261023;
  tables_init();
  recalc();
  halfband_init();
  memset(R_DRYL, 0, 640);
  memset(R_SC, 1, 64);                  // 1/gain = 1: no gain reduction yet
  memset(R_DCL, 0, 4);
  v = 0; vc1 = 0; vc2 = 0; gr = 0; glin = 1;
  c_a = -1; c_l = -1;                   // timing_design() has not run yet
  mk_sm = mk_t; mix_sm = mix_t; col_sm = col_t;
  bp_sw = bp_t; ls_sw = ls_t; sat_sw = sat_t;
  hp_lf = hp_tgt; hp_cnt = 0;
  hz1l = 0; hz2l = 0; hz1r = 0; hz2r = 0;
  hp_design(exp(hp_lf));
  wp = 0;
  first_run = 1;                        // see snap_states()
  mtr_gr1 = 0; mtr_gr = 0; mtr_in = 0; mtr_out = 0;
  gui_scale_idx = UI_SCALE_DEFAULT;
  help_open = 0; help_lines = 0;
) : (
  // @init re-runs on a sample-rate change and on transport start.  The state
  // survives (the non-empty @serialize keeps it); only the rate-dependent
  // scalars are refreshed.
  tables_init();
  recalc();
  halfband_init();
  hp_design(exp(hp_lf));
  timing_design();
);

// REAPER runs @init with the DEFAULT slider values and only then applies the
// project's, so without this the smoothed controls would glide from the
// defaults over the first ~100 ms of playback.  Called from @slider until the
// first sample has run; after that the smoothing is real.  AUDIO THREAD ONLY.
function snap_states()
(
  mk_sm = mk_t; mix_sm = mix_t; col_sm = col_t;
  bp_sw = bp_t; ls_sw = ls_t; sat_sw = sat_t;
  hp_lf = hp_tgt;
  hp_design(exp(hp_lf));
);

// Linear ramp and snap, for the smoothed controls.  AUDIO THREAD ONLY.
function ramp(x, t) ( x < t ? min(x + ramp_s, t) : max(x - ramp_s, t); );
function snap(x, t, eps) ( abs(t - x) < eps ? t : x; );

// Sum over i = 1..12 of c[i]*(buf[wi-p-i] + buf[wi-q+i]) on a ring of 64.
function fir(buf, wi, p, q) local(i, s)
(
  s = 0; i = 1;
  loop(12,
    s += c_tab[i]*(buf[(wi + 64 - p - i) & 63] + buf[(wi + 64 - q + i) & 63]);
    i += 1;
  );
  s;
);

// Colour shaper at the pre-compression level: sc = 1/gain undoes the gain
// reduction for the polynomial and puts it back after, so the harmonics
// follow the input level and only the drive d follows the gain reduction.
function shape(x, d, sc) local(xs, xc)
(
  xs = x*sc;
  xc = max(-1, min(1, xs));
  (xs + d*(SAT_A2*xc*xc - SAT_A3*xc*xc*xc))/sc;
);

// One channel of the processed path.  wi, glin, dsel, ssel, comp, mk and the
// smoothed controls are set up in @sample before the two calls.
function proc_ch(dry, xg, ze, zo, st, x, kf) local(e, o, sat, y, wd, wet, dry_d, pr)
(
  dry[wi] = x;
  xg[wi] = x*glin;
  e = xg[(wi + 64 - 12) & 63];
  o = 2*fir(xg, wi, 11, 12);
  ze[wi] = shape(e, dsel, ssel);
  zo[wi] = shape(o, dsel, ssel);
  sat = (0.5*ze[(wi + 64 - 12) & 63] + fir(zo, wi, 12, 13))*comp;
  y = sat - st[0] + dc_r*st[1];
  st[0] = sat; st[1] = y;
  wd = xg[(wi + 64 - LAT) & 63];
  wet = wd + sat_sw*(y - wd);
  wet *= mk;
  dry_d = dry[(wi + 64 - LAT) & 63];
  pr = dry_d*(1 - mix_sm) + wet*mix_sm;
  pr = pr*(1 - bp_sw) + dry_d*bp_sw;
  pr*(1 - ls_sw) + kf*ls_sw;
);

@slider
recalc();
first_run ? snap_states();

@serialize
// GUI-only state: saved with the project, never in automation.
// APPEND new values, never insert.
file_var(0, gui_scale_idx);

@block
pdc_delay = LAT; pdc_bot_ch = 0; pdc_top_ch = 2;

@sample
first_run = 0;
al = spl0; ar = spl1;
ext_on ? ( kin_l = spl2; kin_r = spl3; ) : ( kin_l = al; kin_r = ar; );

// key high-pass, coefficients glided every HP_BLK samples
hp_cnt -= 1;
hp_cnt <= 0 ? (
  hp_cnt = HP_BLK;
  hp_lf += hp_a*(hp_tgt - hp_lf);
  hp_design(exp(hp_lf));
);
yl = hb0*kin_l + hz1l; hz1l = hb1*kin_l - ha1*yl + hz2l; hz2l = hb2*kin_l - ha2*yl;
yr = hb0*kin_r + hz1r; hz1r = hb1*kin_r - ha1*yr + hz2r; hz2r = hb2*kin_r - ha2*yr;
kfl = hp_on ? yl : kin_l;
kfr = hp_on ? yr : kin_r;

// feedback detector: the key times the gain of the previous sample
(a_k != c_a || l_k != c_l) ? timing_design();
ad = max(abs(kfl), abs(kfr))*glin;
vr = ad > A_FLOOR ? min(VR_CAP, vr_k*exp(eta*(log(ad) - lref))) : 0;

// timing network; the diode only charges
l_k == 4 ? (
  don = vr > vc1 + vc2;
  tec = don ? EC_ON : EC_OFF;
  tn1 = tec[0]*vc1 + tec[1]*vc2;
  tn2 = tec[2]*vc1 + tec[3]*vc2;
  don ? ( tn1 += f1*vr; tn2 += f2*vr; );
  vc1 = tn1; vc2 = tn2; v = tn1 + tn2;
  v > GR_MAX ? ( ts = GR_MAX/v; vc1 *= ts; vc2 *= ts; v = GR_MAX; );
  v < 0.000000001 && abs(vc1) < 0.000000001 ? ( vc1 = 0; vc2 = 0; v = 0; );
) : (
  vr > v ? ( v = v*e_on + f_on*vr; ) : ( v *= e_off; );
  v > GR_MAX ? ( v = GR_MAX; );
  v < 0.000000001 ? ( v = 0; );
);
gr = v;
glin = exp(-gr*DB2LOG);

// smoothed controls and ramps
mk_sm += sm_a*(mk_t - mk_sm);    mk_sm = snap(mk_sm, mk_t, 0.000001);
mix_sm += sm_a*(mix_t - mix_sm); mix_sm = snap(mix_sm, mix_t, 0.0000001);
col_sm += sm_a*(col_t - col_sm); col_sm = snap(col_sm, col_t, 0.0000001);
bp_sw = ramp(bp_sw, bp_t);
ls_sw = ramp(ls_sw, ls_t);
sat_sw = ramp(sat_sw, sat_t);

// per-sample values shared by both channels
wi = wp;
dd_v = col_sm*(SAT_BASE + (1 - SAT_BASE)*min(1, gr/SAT_GR_FULL));
R_DD[wi] = dd_v;
R_SC[wi] = 1/glin;
dsel = R_DD[(wi + 64 - 12) & 63];
ssel = R_SC[(wi + 64 - 12) & 63];
comp = 1/(1 - 0.75*SAT_A3*dsel*SAT_REF2);
mk = exp(mk_sm*DB2LOG);

o_l = proc_ch(R_DRYL, R_XGL, R_ZEL, R_ZOL, R_DCL, al, kfl);
o_r = proc_ch(R_DRYR, R_XGR, R_ZER, R_ZOR, R_DCR, ar, kfr);
wp = (wi + 1) & 63;
spl0 = o_l; spl1 = o_r;

ext_gr_meter = -gr;

// published for @gfx, which only READS these scalars
mi = max(abs(al), abs(ar));
mtr_in = mi > mtr_in ? mi : mtr_in*m_pk;
mo = max(abs(o_l), abs(o_r));
mtr_out = mo > mtr_out ? mo : mtr_out*m_pk;
mtr_gr1 += (gr - mtr_gr1)*m_a;
mtr_gr += (mtr_gr1 - mtr_gr)*m_a;

@gfx 720 360
// ---------------------------------------------------------------------------
// UI THREAD ONLY.  See THREADING at the top.  No audio-side function is
// called from here except recalc().
// ---------------------------------------------------------------------------
gk_begin();
g_chg = 0;

// Shared scale: read it, or seed it if nothing has yet.
gmem[GM_UI_SCALE] > 0 ? gui_scale_idx = gmem[GM_UI_SCALE] - 1
                      : gmem[GM_UI_SCALE] = gui_scale_idx + 1;

// gk_begin set gk_S from gfx_ext_retina (1 or 2).  A fixed percentage is
// relative to that; Fit divides the window by the design size.
g_ret = gk_S;
g_sc = ui_scale(gui_scale_idx);
gk_S = max(0.5, g_sc > 0 ? g_ret * g_sc : min(gfx_w / UI_W, gfx_h / UI_H));
gfx_setfont(1, gk_font, 11*gk_S);
gfx_setfont(2, gk_font, 13*gk_S, 'b');
gfx_setfont(3, gk_font, 9*gk_S);
gfx_setfont(1);

function g_accent(r, g, b) ( gk_ac_r = r; gk_ac_g = g; gk_ac_b = b; );
function g_cyan()   ( g_accent(0.149, 0.784, 0.902); );
function g_orange() ( g_accent(0.941, 0.588, 0.157); );

function g_count_missing(n) local(i, w, h, bad)
(
  i = 0; bad = 0;
  loop(n, gfx_getimgdim(i, w, h); w <= 0 ? bad += 1; i += 1;);
  bad;
);

// logical-coordinate line, 1 logical px wide
function g_line(x0, y0, x1, y1)
(
  gfx_line(x0*gk_S, y0*gk_S, x1*gk_S, y1*gk_S, 1);
);

// Detent label on the knob's sweep.  t is the position 0..1; the 270 degree
// sweep runs from -135 to +135 degrees, 0 = up, as in the filmstrip.
function g_tick(cx, cy, t, str, lit) local(a, tw, th)
(
  a = -2.35619449 + 4.71238898*t;
  gfx_setfont(3);
  lit ? gfx_set(gk_ac_r, gk_ac_g, gk_ac_b, 1) : gfx_set(gk_dim_r, gk_dim_g, gk_dim_b, 1);
  gfx_measurestr(str, tw, th);
  gfx_x = (cx + 41*sin(a))*gk_S - tw*0.5;
  gfx_y = (cy - 41*cos(a))*gk_S - th*0.5;
  gfx_drawstr(str);
  gfx_setfont(1);
);

// Stepped knob: n detents, idx 0..n-1.  Drags 18 px per detent (Shift: 54),
// the wheel steps one, Ctrl-click resets.  Draws the SNAPPED frame, which is
// what makes it feel like a detented switch.  Returns the new index.
function g_knob_step(id, img, x, y, size, n, idx, didx) local(hit, st, t)
(
  hit = gk_hit(x, y, size, size);
  gk_clicked && hit ? (
    mouse_cap & 4 ? idx = didx : ( gk_active = id; gk_lasty = mouse_y; g_kacc = 0; );
  );
  gk_active == id && (mouse_cap & 1) ? (
    g_kacc += (gk_lasty - mouse_y)/gk_S;
    gk_lasty = mouse_y;
    st = (mouse_cap & 8) ? 54 : 18;
    while (g_kacc >= st) ( idx += 1; g_kacc -= st; );
    while (g_kacc <= -st) ( idx -= 1; g_kacc += st; );
  );
  mouse_wheel != 0 && hit ? (
    idx += mouse_wheel > 0 ? 1 : -1;
    mouse_wheel = 0;
  );
  idx = gk_clamp(idx, 0, n - 1);
  t = idx/(n - 1);
  gk_strip_grid(img, gk_knob_frames, gk_knob_cols, t*(gk_knob_frames - 1), x, y, size, size)
    ? 0 : gk_knob_vector(x, y, size, t);
  idx;
);

// Sidechain HPF knob position <-> Hz: log from 20 to 500 Hz over 4%..100% of
// the travel, with the bottom 4% = Off (0 Hz).
function g_hz2p(hz) ( hz < 20 ? 0 : 0.04 + 0.96*log(hz/20)/log(25); );
function g_p2hz(p) ( p < 0.04 ? 0 : floor(20*exp((p - 0.04)/0.96*log(25)) + 0.5); );

// GR meter, mirrored: 0 dB at the RIGHT end of the scale, 15 dB at the left,
// +-41 degrees about straight up.  0..5 dB takes the right half of the travel
// (that is where bus work happens), 5..15 dB the left half.  The geometry is
// mirrored in tools/make_meter_face.py, which draws the face: change both.
function g_trav(gdb) ( gdb = min(max(gdb, 0), 15); gdb <= 5 ? 0.1*gdb : 0.5 + 0.05*(gdb - 5); );
function g_mang(gdb) ( 0.71558499 - 1.43116999*g_trav(gdb); );

// ---------------------------------------------------------------- header
gk_header(0, 10, 10, UI_W - 20, 22, "BUS COMPRESSOR", -1, 0);
g_r  = min(UI_W - 20, gfx_w/gk_S - 10);
g_sx = g_r - 86;
g_i = gk_dropdown(40, g_sx, 13, 64, 16, gui_scale_idx, "Fit|100%|125%|150%|200%",
      gui_scale_idx == 0 ? "Fit"  : gui_scale_idx == 1 ? "100%" :
      gui_scale_idx == 2 ? "125%" : gui_scale_idx == 3 ? "150%" : "200%");
g_i != gui_scale_idx ? ( gui_scale_idx = g_i; gmem[GM_UI_SCALE] = g_i + 1; );

gk_button(41, g_r - 18, 13, 18, 16, help_open, "?") ? (
  help_open = !help_open;
  help_open && !help_lines ? help_lines = gk_help_load(HELP_FILE, HELP_BASE, HELP_MAX);
);
// Must come after the header controls and before every other widget.
help_open ? gk_help_input(40, 41);
gk_button(42, g_sx - 62, 13, 58, 16, bypass > 0.5, "BYPASS") ? (
  bypass = bypass > 0.5 ? 0 : 1;
  slider_automate(2^10);
  g_chg = 1;
);

// ---------------------------------------------------------------- compressor
gk_panel(10, 40, 470, 168);
gk_header(0, 10, 40, 470, 22, "COMPRESSOR", -1, 0);
g_cyan();
g_ky = 84; g_kc = g_ky + 32;

// Threshold (slider 1, continuous)
g_cx = 57;
g_chg |= gk_knob_slider(10, 0, g_cx - 32, g_ky, 64, 1, -40, 0, -10);
g_tick(g_cx, g_kc, 0,    "-40", 0);
g_tick(g_cx, g_kc, 0.25, "-30", 0);
g_tick(g_cx, g_kc, 0.5,  "-20", 0);
g_tick(g_cx, g_kc, 0.75, "-10", 0);
g_tick(g_cx, g_kc, 1,    "0",   0);
gk_text_c(g_cx, 154, "Threshold", 1);
sprintf(#g_s, "%.1f dB", thr_db);
g_chg |= gk_field_edit_slider(50, g_cx - 30, 170, 60, 16, 1, -40, 0, -10, #g_s);

// Ratio (slider 2, stepped 2 / 4 / 10)
g_cx = 151;
g_ri = min(max(floor(ratio_i + 0.5), 0), 2);
g_ni = g_knob_step(11, 0, g_cx - 32, g_ky, 64, 3, g_ri, 1);
g_ni != g_ri ? ( ratio_i = g_ni; slider_automate(2^1); g_chg = 1; g_ri = g_ni; );
g_tick(g_cx, g_kc, 0,   "2",  g_ri == 0);
g_tick(g_cx, g_kc, 0.5, "4",  g_ri == 1);
g_tick(g_cx, g_kc, 1,   "10", g_ri == 2);
gk_text_c(g_cx, 154, "Ratio", 1);
sprintf(#g_s, "%d : 1", g_ri == 0 ? 2 : g_ri == 1 ? 4 : 10);
gk_field(g_cx - 30, 170, 60, 16, #g_s);

// Attack (slider 3, stepped 0.1 .3 1 3 10 30 ms)
g_cx = 245;
g_ai = min(max(floor(att_i + 0.5), 0), 5);
g_ni = g_knob_step(12, 0, g_cx - 32, g_ky, 64, 6, g_ai, 4);
g_ni != g_ai ? ( att_i = g_ni; slider_automate(2^2); g_chg = 1; g_ai = g_ni; );
g_tick(g_cx, g_kc, 0,   "0.1", g_ai == 0);
g_tick(g_cx, g_kc, 0.2, "0.3", g_ai == 1);
g_tick(g_cx, g_kc, 0.4, "1",   g_ai == 2);
g_tick(g_cx, g_kc, 0.6, "3",   g_ai == 3);
g_tick(g_cx, g_kc, 0.8, "10",  g_ai == 4);
g_tick(g_cx, g_kc, 1,   "30",  g_ai == 5);
gk_text_c(g_cx, 154, "Attack", 1);
g_ai == 0 ? sprintf(#g_s, "0.1 ms") : g_ai == 1 ? sprintf(#g_s, "0.3 ms") :
g_ai == 2 ? sprintf(#g_s, "1 ms") : g_ai == 3 ? sprintf(#g_s, "3 ms") :
g_ai == 4 ? sprintf(#g_s, "10 ms") : sprintf(#g_s, "30 ms");
gk_field(g_cx - 30, 170, 60, 16, #g_s);

// Release (slider 4, stepped 0.1 .3 .6 1.2 s, then Auto)
g_cx = 339;
g_li = min(max(floor(rel_i + 0.5), 0), 4);
g_ni = g_knob_step(13, 0, g_cx - 32, g_ky, 64, 5, g_li, 1);
g_ni != g_li ? ( rel_i = g_ni; slider_automate(2^3); g_chg = 1; g_li = g_ni; );
g_tick(g_cx, g_kc, 0,    "0.1",  g_li == 0);
g_tick(g_cx, g_kc, 0.25, "0.3",  g_li == 1);
g_tick(g_cx, g_kc, 0.5,  "0.6",  g_li == 2);
g_tick(g_cx, g_kc, 0.75, "1.2",  g_li == 3);
g_tick(g_cx, g_kc, 1,    "AUTO", g_li == 4);
gk_text_c(g_cx, 154, "Release", 1);
g_li == 0 ? sprintf(#g_s, "0.1 s") : g_li == 1 ? sprintf(#g_s, "0.3 s") :
g_li == 2 ? sprintf(#g_s, "0.6 s") : g_li == 3 ? sprintf(#g_s, "1.2 s") : sprintf(#g_s, "Auto");
gk_field(g_cx - 30, 170, 60, 16, #g_s);

// Makeup (slider 5, continuous)
g_cx = 433;
g_chg |= gk_knob_slider(14, 0, g_cx - 32, g_ky, 64, 5, 0, 20, 0);
g_tick(g_cx, g_kc, 0,   "0",   0);
g_tick(g_cx, g_kc, 0.5, "+10", 0);
g_tick(g_cx, g_kc, 1,   "+20", 0);
gk_text_c(g_cx, 154, "Makeup", 1);
sprintf(#g_s, "%+.1f dB", makeup_db);
g_chg |= gk_field_edit_slider(51, g_cx - 30, 170, 60, 16, 5, 0, 20, 0, #g_s);

// ---------------------------------------------------------------- gain reduction
gk_panel(490, 40, 220, 168);
gk_header(0, 490, 40, 220, 22, "GAIN REDUCTION", -1, 0);

// meter face: the backlit display is a prerendered image (scale, glow, hub);
// the needle, hold tick and readout are drawn live on top of it
g_fx = 506; g_fy = 70; g_fw = 188; g_fh = 88;
g_px = g_fx + 94; g_py = g_fy + 62;          // needle pivot, below the face
g_hub = 58; g_rn = 116; g_r0 = 112;
gk_strip(METER_IMG, 1, 0, g_fx, g_fy, g_fw, g_fh) ? 0 : (
  // vector fallback if the image did not load: dark face, bare scale
  gfx_set(0.03, 0.08, 0.15, 1);
  gfx_rect(g_fx*gk_S, g_fy*gk_S, g_fw*gk_S, g_fh*gk_S);
  gfx_set(0.80, 0.91, 1, 1);
  gfx_setfont(3);
  gi = 0;
  loop(9,
    g_g = gi == 0 ? 0 : gi == 1 ? 1 : gi == 2 ? 2 : gi == 3 ? 3 : gi == 4 ? 4 :
          gi == 5 ? 5 : gi == 6 ? 7 : gi == 7 ? 10 : 15;
    g_a = g_mang(g_g);
    g_line(g_px + (g_r0 - 6)*sin(g_a), g_py - (g_r0 - 6)*cos(g_a),
           g_px + g_r0*sin(g_a), g_py - g_r0*cos(g_a));
    sprintf(#g_n, "%d", g_g);
    gfx_measurestr(#g_n, g_tw, g_th);
    gfx_x = (g_px + (g_r0 - 15)*sin(g_a))*gk_S - g_tw*0.5;
    gfx_y = (g_py - (g_r0 - 15)*cos(g_a))*gk_S - g_th*0.5;
    gfx_drawstr(#g_n);
    gi += 1;
  );
  gfx_setfont(1);
);

// peak hold: ~1 s, then it falls back to the needle
g_gr = min(max(mtr_gr, 0), 15);
g_gr >= g_hold ? ( g_hold = g_gr; g_hold_t = 60; ) :
  g_hold_t > 0 ? ( g_hold_t -= 1; ) : ( g_hold = max(g_hold - 0.12, g_gr); );

// thick line made of parallel 1 px lines, perpendicular offsets in logical px
function g_thick(x0, y0, x1, y1, w, ca) local(k, ox, oy, n)
(
  ox = (y1 - y0); oy = -(x1 - x0);
  n = sqrt(ox*ox + oy*oy); ox /= n; oy /= n;
  k = -w*0.5 + 0.25;
  while (k <= w*0.5) (
    gfx_a = ca;
    g_line(x0 + ox*k, y0 + oy*k, x1 + ox*k, y1 + oy*k);
    k += 0.5;
  );
);

// hold tick, just outside the scale
g_a = g_mang(g_hold);
gfx_set(0.55, 0.80, 1, 0.9);
g_line(g_px + (g_r0 + 3)*sin(g_a), g_py - (g_r0 + 3)*cos(g_a),
       g_px + (g_r0 + 8)*sin(g_a), g_py - (g_r0 + 8)*cos(g_a));

// needle: a soft blue glow, then a white-cyan core
g_a = g_mang(g_gr);
g_x0 = g_px + g_hub*sin(g_a); g_y0 = g_py - g_hub*cos(g_a);
g_x1 = g_px + g_rn*sin(g_a);  g_y1 = g_py - g_rn*cos(g_a);
gfx_set(0.35, 0.75, 1, 0.09);  g_thick(g_x0, g_y0, g_x1, g_y1, 5, 0.09);
gfx_set(0.35, 0.75, 1, 0.18);  g_thick(g_x0, g_y0, g_x1, g_y1, 3, 0.18);
gfx_set(0.91, 0.97, 1, 1);     g_thick(g_x0, g_y0, g_x1, g_y1, 1.1, 1);
gfx_a = 1;

// readout, bottom left of the face
gfx_setfont(3);
gfx_set(0.59, 0.82, 1, 1);
gfx_x = (g_fx + 9)*gk_S; gfx_y = (g_fy + g_fh - 17)*gk_S;
sprintf(#g_s, "-%.1f", mtr_gr);
gfx_drawstr(#g_s);
gfx_setfont(1);

// IN / OUT peak bars with hold
function g_bar(y, lab, lv, hold) local(i, bx, bw, seg, on, f)
(
  gfx_set(gk_dim_r, gk_dim_g, gk_dim_b, 1);
  gfx_setfont(3);
  gfx_x = 506*gk_S; gfx_y = (y - 1)*gk_S;
  gfx_drawstr(lab);
  gfx_setfont(1);
  bx = 528; bw = 130; seg = 26;
  gfx_set(0.02, 0.04, 0.08, 1);
  gfx_rect(bx*gk_S, (y - 1)*gk_S, bw*gk_S, 7*gk_S);
  i = 0;
  loop(seg,
    on = (i + 1)/seg <= (lv + 60)/60 + 0.0001;
    f = i/seg;
    on ? (
      f < 0.78 ? gfx_set(gk_ac_r, gk_ac_g, gk_ac_b, 1) :
      f < 0.92 ? gfx_set(0.96, 0.77, 0.26, 1) : gfx_set(1, 0.31, 0.27, 1);
    ) : gfx_set(0.055, 0.10, 0.17, 1);
    gfx_rect((bx + i*bw/seg)*gk_S + 1, (y - 1)*gk_S + 1, (bw/seg)*gk_S - 1, 7*gk_S - 2);
    i += 1;
  );
  gfx_set(0.80, 0.91, 1, 1);
  f = min(max((hold + 60)/60, 0), 1);
  gfx_rect((bx + f*bw)*gk_S, (y - 1)*gk_S, max(1, gk_S), 7*gk_S);
);
// level in dB, floor -60; hold: 45 frames, then falls
g_lin = mtr_in > 0.000001 ? 20*log10(mtr_in) : -120;
g_lout = mtr_out > 0.000001 ? 20*log10(mtr_out) : -120;
g_lin >= g_hin ? ( g_hin = g_lin; g_hin_t = 45; ) :
  g_hin_t > 0 ? ( g_hin_t -= 1; ) : ( g_hin = max(g_hin - 0.8, g_lin); );
g_lout >= g_hout ? ( g_hout = g_lout; g_hout_t = 45; ) :
  g_hout_t > 0 ? ( g_hout_t -= 1; ) : ( g_hout = max(g_hout - 0.8, g_lout); );
g_cyan();
g_bar(173, "IN",  g_lin,  g_hin);
g_bar(188, "OUT", g_lout, g_hout);
g_hin > -100  ? sprintf(#g_s, "%.1f", g_hin)  : sprintf(#g_s, "-inf");
gk_field(662, 169, 36, 14, #g_s);
g_hout > -100 ? sprintf(#g_s, "%.1f", g_hout) : sprintf(#g_s, "-inf");
gk_field(662, 184, 36, 14, #g_s);

// ---------------------------------------------------------------- sidechain
gk_panel(10, 218, 230, 112);
gk_header(0, 10, 218, 230, 22, "SIDECHAIN", -1, 0);
g_orange();
g_cx = 50;
// the knob keeps its own continuous position while it is dragged, so slow
// drags at the low end are not lost to rounding the Hz to a whole number
gk_active != 15 ? ( g_hp = g_hz2p(hpf_hz); );
g_np = gk_knob(15, 1, g_cx - 32, 252, 64, g_hp, 0, 1, 0);
g_np != g_hp ? (
  g_hp = g_np;
  g_hz = g_p2hz(g_np);
  g_hz != hpf_hz ? ( hpf_hz = g_hz; slider_automate(2^5); g_chg = 1; );
);
g_tick(g_cx, 284, 0,            "Off", hpf_hz < 20);
g_tick(g_cx, 284, g_hz2p(50),   "50",  0);
g_tick(g_cx, 284, g_hz2p(150),  "150", 0);
g_tick(g_cx, 284, 1,            "500", 0);
gk_text(112, 247, "Key HPF");
hpf_hz < 20 ? sprintf(#g_s, "Off") : sprintf(#g_s, "%.0f Hz", hpf_hz);
g_chg |= gk_field_edit_slider(52, 112, 262, 60, 16, 6, 0, 500, 0, #g_s);
gk_text(112, 286, "Ext key (3/4)");
g_chg |= gk_toggle_slider(21, TOG_IMG, 196, 284, 28, 16, 7);
gk_text(112, 308, "Listen");
g_chg |= gk_toggle_slider(22, TOG_IMG, 196, 306, 28, 16, 8);

// ---------------------------------------------------------------- colour
gk_panel(250, 218, 230, 112);
gk_header(0, 250, 218, 230, 22, "COLOUR", -1, 0);
g_orange();
g_chg |= gk_knob_slider(16, 1, 268, 252, 64, 9, 0, 100, 0);
gk_text(350, 260, "Colour");
sprintf(#g_s, "%.0f %%", colour);
g_chg |= gk_field_edit_slider(53, 350, 278, 66, 16, 9, 0, 100, 0, #g_s);
gfx_setfont(3);
gfx_set(gk_dim_r, gk_dim_g, gk_dim_b, 1);
gfx_x = 350*gk_S; gfx_y = 300*gk_S;
gfx_drawstr("grows with gain reduction");
gfx_setfont(1);

// ---------------------------------------------------------------- parallel
gk_panel(490, 218, 220, 112);
gk_header(0, 490, 218, 220, 22, "PARALLEL", -1, 0);
g_orange();
g_chg |= gk_knob_slider(17, 1, 508, 252, 64, 10, 0, 100, 100);
gk_text(590, 260, "Dry / Wet");
sprintf(#g_s, "%.0f %%", mix);
g_chg |= gk_field_edit_slider(54, 590, 278, 66, 16, 10, 0, 100, 100, #g_s);
gfx_setfont(3);
gfx_set(gk_dim_r, gk_dim_g, gk_dim_b, 1);
gfx_x = 590*gk_S; gfx_y = 300*gk_S;
gfx_drawstr("makeup on wet only");
gfx_setfont(1);

// ---------------------------------------------------------------- help
help_open ? gk_help_draw(10, 40, UI_W - 20, UI_H - 64, "Help  -  Bus Compressor",
                         HELP_BASE, help_lines);

// ---------------------------------------------------------------- footer
// Version label: bump on EVERY change - REAPER caches the compiled JSFX per
// open instance, so a stale instance is otherwise invisible.
gfx_setfont(3);
gfx_set(0.35, 0.37, 0.40, 1);
gfx_x = 10*gk_S; gfx_y = (UI_H - 22)*gk_S;
sprintf(#g_s, "v0.2   latency %d smp (2x oversampler, PDC)", LAT);
gfx_drawstr(#g_s);
gfx_setfont(1);
gk_strip(LOGO_IMG, 1, 0, UI_W - 10 - 14*LOGO_ASPECT, UI_H - 24, 14*LOGO_ASPECT, 14);

g_bad = g_count_missing(IMG_COUNT);
g_bad > 0 ? (
  gfx_set(1, 0.42, 0.38, 1);
  gfx_x = 300*gk_S; gfx_y = 15*gk_S;
  gfx_drawstr("images failed to load: ");
  gfx_drawnumber(g_bad, 0);
);

g_chg ? recalc();
gk_end();
